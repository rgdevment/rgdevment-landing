---
import StoryPage from "../../../../components/StoryPage.astro";
import { NEWS_PATH, homeStories } from "../../../../content/news";

export async function getStaticPaths() {
  return (await homeStories()).map((one) => ({ params: { news: NEWS_PATH.en, version: one.version } }));
}

const { version } = Astro.params;
---

<StoryPage locale="en" version={version!} />
