---
import StoryPage from "../../../../../components/StoryPage.astro";
import { NEWS_PATH, homeStories } from "../../../../../content/news";

export async function getStaticPaths() {
  return (await homeStories()).map((one) => ({ params: { noticias: NEWS_PATH.es, story: one.page.es } }));
}

const { story } = Astro.params;
---

<StoryPage locale="es" page={story!} />
