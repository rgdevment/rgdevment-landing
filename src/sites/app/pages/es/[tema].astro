---
import TopicPage from "../../../../components/tisty/TopicPage.astro";
import { TOPICS, TOPICS_OF, TOPIC_PATH, type Topic } from "../../../../content/topics";
import { HOME_PRODUCT } from "../../../../site";

export function getStaticPaths() {
  return HOME_PRODUCT === TOPICS_OF ? TOPICS.map((topic) => ({ params: { tema: TOPIC_PATH[topic].es }, props: { topic } })) : [];
}

const { topic } = Astro.props as { topic: Topic };
---

<TopicPage topic={topic} locale="es" />
