---
import Icon from "../components/Icon.astro";
import Layout from "../layouts/Layout.astro";
import { PRODUCTS } from "../content/products";
import { href } from "../site";
---

<Layout
  title="404 · rgdevment"
  description="This page does not exist. Esta página no existe."
  locale="en"
  noindex
>
  <section class="relative isolate overflow-hidden">
    <div class="halo absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="shell py-24 text-center sm:py-32">
      <p class="font-mono text-sm text-muted">404</p>
      <h1 class="mt-4 text-5xl font-semibold tracking-[-0.03em] sm:text-6xl">This page is not here.</h1>
      <p class="mt-3 font-display text-2xl text-muted" lang="es">Esta página no está aquí.</p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a class="btn-primary" href={href("en")}>Home <Icon name="arrow" class="h-4 w-4" /></a>
        <a class="btn-ghost" href={href("es")} lang="es">Inicio en español</a>
      </div>
      <ul class="mx-auto mt-14 flex max-w-md justify-center gap-5">
        {
          PRODUCTS.map((one) => (
            <li>
              <a class="group flex flex-col items-center gap-2 text-sm text-muted hover:text-fg" href={href("en", one.slug)}>
                <img src={one.icon} alt="" width="56" height="56" class="h-14 w-14 rounded-2xl transition group-hover:-translate-y-0.5" />
                {one.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>
