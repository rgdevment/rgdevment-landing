---
// What a first reader does not need yet stays in the page, folded: search engines and assistants still read it all.
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<details class="more mt-6">
  <summary class="more-toggle">
    <span>{label}</span>
    <svg class="more-arrow h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="M5 8l5 5 5-5" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </summary>
  <div class="mt-6"><slot /></div>
</details>
