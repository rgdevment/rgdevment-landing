---
import { CHANGELOG_PATH, hasChangelog } from "../content/changelog";
import { COMPARE_PATH, compares } from "../content/compare";
import { docPath } from "../content/docs";
import { NEWS_PATH, hasNews } from "../content/news";
import type { Product } from "../content/products";
import { iconAlt } from "../content/products";
import { href, type Locale } from "../site";
import ThemeSwitch from "./ThemeSwitch.astro";

interface Props {
  product: Product;
  locale: Locale;
  other: string;
}

const { product, locale, other } = Astro.props;
const there: Locale = locale === "es" ? "en" : "es";
const es = locale === "es";
const link = "rounded-full px-3 py-1.5 text-muted transition-colors hover:text-fg";
const words = product[locale].language;
type Item = [to: string, label: string, external: boolean];
const items: Item[] = [
  [href(locale, es ? "precios" : "pricing"), es ? "Precios" : "Pricing", false],
  ...(compares(product.slug) ? [[href(locale, COMPARE_PATH[locale]), es ? "Comparar" : "Compare", false] as Item] : []),
  ...((await hasNews(product.slug))
    ? [[href(locale, NEWS_PATH[locale]), es ? "Noticias" : "News", false] as Item]
    : hasChangelog(product.slug)
      ? [[href(locale, CHANGELOG_PATH[locale]), es ? "Novedades" : "What's new", false] as Item]
      : []),
  [href(locale, es ? "colaborar" : "support"), es ? "Colaborar" : "Support", false],
  [href(locale, docPath(locale, product.slug)), es ? "Ayuda" : "Docs", false],
  ...(words ? [[words.url, "Markdown", true] as Item] : []),
];
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-canvas/80 backdrop-blur-xl backdrop-saturate-150">
  <nav aria-label={es ? "Principal" : "Main"} class="shell flex h-16 items-center gap-6">
    <a class="flex shrink-0 items-center gap-3" href={href(locale)} aria-label={es ? `${product.name}, inicio` : `${product.name}, home`}>
      <img src={product.icon} alt={iconAlt(product, locale)} width="28" height="28" class="h-7 w-7 rounded-lg" />
      <span class="text-lg font-semibold text-fg">{product.name}</span>
    </a>

    <ul class="ml-auto hidden items-center gap-1 text-[15px] lg:flex">
      {
        items.map(([to, label, external]) => (
          <li>
            <a class={link} href={to} rel={external ? "noopener" : undefined}>
              {label}
            </a>
          </li>
        ))
      }
      <li class="ml-2">
        <a
          class="rounded-full border border-line px-3 py-1 text-xs text-muted transition-colors hover:border-fg/30 hover:text-fg"
          href={href(there, other)}
          lang={there}
          hreflang={there}
          title={es ? "Read in English" : "Leer en español"}
        >
          {es ? "EN" : "ES"}
        </a>
      </li>
      <li>
        <ThemeSwitch locale={locale} />
      </li>
    </ul>

    <ThemeSwitch locale={locale} class="ml-auto lg:hidden" />
    <details class="group lg:hidden">
      <summary
        class="grid h-10 w-10 cursor-pointer list-none place-items-center rounded-full border border-line text-fg [&::-webkit-details-marker]:hidden"
        aria-label={es ? "Menú" : "Menu"}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-5 w-5 group-open:hidden" aria-hidden="true">
          <path d="M4 8h16M4 16h16" />
        </svg>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="hidden h-5 w-5 group-open:block" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </summary>

      <div class="absolute inset-x-0 top-16 border-b border-line bg-canvas/95 shadow-xl backdrop-blur-xl">
        <ul class="shell grid gap-1 py-4 text-lg">
          {
            items.map(([to, label, external]) => (
              <li>
                <a class="block rounded-2xl px-3 py-2.5 text-body" href={to} rel={external ? "noopener" : undefined}>
                  {label}
                </a>
              </li>
            ))
          }
          <li class="my-2 h-px bg-line" aria-hidden="true"></li>
          <li>
            <a class="block rounded-2xl px-3 py-2.5 text-muted" href={href(there, other)} lang={there} hreflang={there}>
              {es ? "English" : "Español"}
            </a>
          </li>
        </ul>
      </div>
    </details>
  </nav>
</header>
