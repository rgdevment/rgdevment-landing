---
import type { Locale } from "../site";

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: klass = "" } = Astro.props;
const label = locale === "es" ? "Claro u oscuro" : "Light or dark";
---

<button
  type="button"
  data-theme-switch
  aria-label={label}
  title={label}
  class={`grid h-9 w-9 shrink-0 place-items-center rounded-full border border-line text-muted transition-colors hover:border-fg/30 hover:text-fg ${klass}`}
>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="on-light h-4 w-4" aria-hidden="true">
    <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401" />
  </svg>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="on-dark h-4 w-4" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
  </svg>
</button>

<script>
  const root = document.documentElement;
  const dark = () => (root.dataset.theme ?? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light")) === "dark";
  for (const button of document.querySelectorAll("[data-theme-switch]")) {
    button.addEventListener("click", () => {
      const now = dark() ? "light" : "dark";
      root.dataset.theme = now;
      try {
        localStorage.setItem("theme", now);
      } catch {}
      dispatchEvent(new Event("themechange"));
    });
  }
</script>
