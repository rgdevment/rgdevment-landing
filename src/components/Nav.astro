---
import Logo from "./Logo.astro";
import { PRODUCTS } from "../content/products";
import { href, type Locale } from "../site";

interface Props {
  locale: Locale;
  here?: string;
  other: string;
}

const { locale, here, other } = Astro.props;
const there: Locale = locale === "es" ? "en" : "es";
const es = locale === "es";

const pages: [string, string, string][] = es
  ? [
      ["guias", "Guías", "guides"],
      ["precios", "Precios", "pricing"],
      ["colaborar", "Colaborar", "support"],
    ]
  : [
      ["guides", "Guides", "guides"],
      ["pricing", "Pricing", "pricing"],
      ["support", "Support", "support"],
    ];

const link = (key: string) =>
  here === key
    ? "rounded-full bg-fg/[0.06] px-3 py-1.5 text-fg"
    : "rounded-full px-3 py-1.5 text-muted transition-colors hover:text-fg";
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-canvas/80 backdrop-blur-xl backdrop-saturate-150">
  <nav aria-label={es ? "Principal" : "Main"} class="shell flex h-16 items-center gap-6">
    <a class="flex shrink-0 items-center" href={href(locale)} aria-label={es ? "rgdevment, inicio" : "rgdevment, home"}>
      <Logo class="h-[22px] w-auto sm:h-6" />
    </a>

    <ul class="ml-auto hidden items-center gap-1 text-[15px] lg:flex">
      <li>
        <a class={link("home")} aria-current={here === "home" ? "page" : undefined} href={href(locale)}>
          {es ? "Inicio" : "Home"}
        </a>
      </li>
      {
        PRODUCTS.map((one) => (
          <li>
            <a
              class={`inline-flex items-center gap-2 ${link(one.slug)}`}
              aria-current={here === one.slug ? "page" : undefined}
              href={href(locale, one.slug)}
            >
              <img src={one.icon} alt="" width="18" height="18" class="h-[18px] w-[18px] rounded-[5px]" />
              {one.name}
            </a>
          </li>
        ))
      }
      <li aria-hidden="true" class="mx-2 h-4 w-px bg-line"></li>
      {
        pages.map(([slug, label, key]) => (
          <li>
            <a class={link(key)} aria-current={here === key ? "page" : undefined} href={href(locale, slug)}>
              {label}
            </a>
          </li>
        ))
      }
      <li class="ml-2">
        <a
          class="rounded-full border border-line px-3 py-1 font-mono text-xs text-muted transition-colors hover:border-fg/30 hover:text-fg"
          href={href(there, other)}
          lang={there}
          hreflang={there}
          title={es ? "Read in English" : "Leer en español"}
        >
          {es ? "EN" : "ES"}
        </a>
      </li>
    </ul>

    <details class="group ml-auto lg:hidden">
      <summary
        class="grid h-10 w-10 cursor-pointer list-none place-items-center rounded-full border border-line text-fg [&::-webkit-details-marker]:hidden"
        aria-label={es ? "Menú" : "Menu"}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-5 w-5 group-open:hidden" aria-hidden="true">
          <path d="M4 8h16M4 16h16" />
        </svg>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="hidden h-5 w-5 group-open:block" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </summary>

      <div class="absolute inset-x-0 top-16 border-b border-line bg-canvas/95 shadow-xl backdrop-blur-xl">
        <ul class="shell grid gap-1 py-4 text-lg">
          <li>
            <a
              class={`block rounded-2xl px-3 py-2.5 ${here === "home" ? "bg-surface text-fg" : "text-body"}`}
              aria-current={here === "home" ? "page" : undefined}
              href={href(locale)}
            >
              {es ? "Inicio" : "Home"}
            </a>
          </li>
          {
            PRODUCTS.map((one) => (
              <li>
                <a
                  class={`flex items-center gap-3 rounded-2xl px-3 py-2.5 ${here === one.slug ? "bg-surface text-fg" : "text-body"}`}
                  aria-current={here === one.slug ? "page" : undefined}
                  href={href(locale, one.slug)}
                >
                  <img src={one.icon} alt="" width="28" height="28" class="h-7 w-7 rounded-lg" />
                  {one.name}
                </a>
              </li>
            ))
          }
          <li class="my-2 h-px bg-line" aria-hidden="true"></li>
          {
            pages.map(([slug, label, key]) => (
              <li>
                <a
                  class={`block rounded-2xl px-3 py-2.5 ${here === key ? "bg-surface text-fg" : "text-body"}`}
                  aria-current={here === key ? "page" : undefined}
                  href={href(locale, slug)}
                >
                  {label}
                </a>
              </li>
            ))
          }
          <li>
            <a class="block rounded-2xl px-3 py-2.5 text-muted" href={href(there, other)} lang={there} hreflang={there}>
              {es ? "English" : "Español"}
            </a>
          </li>
        </ul>
      </div>
    </details>
  </nav>
</header>
