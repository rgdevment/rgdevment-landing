---
import { render } from "astro:content";
import Crumbs from "./Crumbs.astro";
import Layout from "../layouts/Layout.astro";
import { NEWS_PATH, homeProduct, newsWords, sentence, storiesOf, storyPath, storySummary } from "../content/news";
import { cardOf } from "../content/products";
import { DOMAIN, PERSON_ID, appId, canonical, crumbs, href, longDate, type Locale } from "../site";

interface Props {
  locale: Locale;
  version: string;
}

const { locale, version } = Astro.props;
const product = homeProduct()!;
const t = newsWords(product, locale);
const stories = await storiesOf(product);
const at = stories.findIndex((one) => one.version === version);
const story = stories[at];
const [newer, older] = [stories[at - 1], stories[at + 1]];
const headline = story.headline[locale];
const paths = { en: storyPath("en", version), es: storyPath("es", version) };
const trail: [string, string][] = [[product.name, ""], [t.short, NEWS_PATH[locale]], [version, paths[locale]]];
const description = storySummary(product, story, locale);
const article = story.article[locale];
const Content = article ? (await render(article)).Content : null;
const image = article?.data.card ? { src: article.data.card, width: 1200, height: 630 } : undefined;
const card = image ?? cardOf(product, locale);
const url = canonical(locale, paths[locale]);
const posting = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: `${product.name} ${version}: ${headline}`,
  description,
  datePublished: story.date,
  inLanguage: locale,
  url,
  mainEntityOfPage: url,
  author: { "@id": PERSON_ID },
  publisher: { "@id": PERSON_ID },
  about: { "@id": appId(product.slug) },
  ...(card ? { image: new URL(card.src, DOMAIN).toString() } : {}),
};
const neighbour = "block rounded-3xl border border-line p-5 transition-colors hover:border-fg/30";
---

<Layout title={`${product.name} ${version}: ${headline}`} description={description} locale={locale} paths={paths} published={story.date} image={image} schema={[crumbs(locale, trail), posting]}>
  <article class="shell pt-10 sm:pt-14" style={`--accent: ${product.accent}`}>
    <Crumbs locale={locale} trail={trail} />
    <header class="mt-10 max-w-3xl">
      <p class="eyebrow">{product.name} {version}</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-[-0.03em] sm:text-5xl">{headline}</h1>
      <p class="mt-4 text-sm text-muted">
        <time datetime={story.date}>{longDate(story.date, locale)}</time>
        <span class="px-2" aria-hidden="true">·</span>
        <a class="underline decoration-muted underline-offset-4 hover:text-fg" href={story.release} rel="noopener">{t.github}</a>
      </p>
      {!Content && <p class="mt-6 text-lg text-body">{t.out(version)}</p>}
    </header>

    {
      Content ? (
        <div class="prose prose-lg mt-10 max-w-3xl">
          <Content />
        </div>
      ) : (
        <div class="mt-10 max-w-3xl space-y-8">
          {story.told[locale].map((one) => (
            <section>
              <h2 class="text-xl font-semibold tracking-[-0.01em] text-fg">{one.title}</h2>
              <p class="mt-2 text-body">{sentence(one.said, locale)}</p>
            </section>
          ))}
        </div>
      )
    }

    <aside class="mt-12 max-w-3xl rounded-3xl border border-line bg-sunken/60 p-6 sm:p-8">
      <p class="text-body">{t.updates}</p>
      <a class="btn-primary mt-5" href={`${href(locale)}#download`}>{t.download}</a>
    </aside>

    <nav aria-label={t.short} class="mt-12 grid max-w-3xl gap-4 sm:grid-cols-2">
      {
        older && (
          <a class={neighbour} href={href(locale, storyPath(locale, older.version))}>
            <span class="text-sm text-muted">{t.older} · {older.version}</span>
            <span class="mt-1 block font-medium text-fg">{older.headline[locale]}</span>
          </a>
        )
      }
      {
        newer && (
          <a class={`${neighbour} sm:col-start-2 sm:text-right`} href={href(locale, storyPath(locale, newer.version))}>
            <span class="text-sm text-muted">{t.newer} · {newer.version}</span>
            <span class="mt-1 block font-medium text-fg">{newer.headline[locale]}</span>
          </a>
        )
      }
    </nav>
  </article>
</Layout>
