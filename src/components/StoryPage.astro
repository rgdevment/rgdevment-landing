---
import { getImage } from "astro:assets";
import { render } from "astro:content";
import Crumbs from "./Crumbs.astro";
import Layout from "../layouts/Layout.astro";
import { NEWS_PATH, homeProduct, newsWords, storiesOf, storyPath } from "../content/news";
import { cardOf } from "../content/products";
import { DOMAIN, PERSON_ID, appId, canonical, crumbs, href, longDate, type Locale } from "../site";

interface Props {
  locale: Locale;
  page: string;
}

const { locale, page } = Astro.props;
const product = homeProduct()!;
const t = newsWords(product, locale);
const stories = await storiesOf(product);
const at = stories.findIndex((one) => one.page[locale] === page);
const story = stories[at];
const [newer, older] = [stories[at - 1], stories[at + 1]];
const article = story.article[locale];
const { title, description, cover } = article.data;
const { Content } = await render(article);
const paths = { en: storyPath("en", story.page.en), es: storyPath("es", story.page.es) };
const trail: [string, string][] = [[product.name, ""], [t.short, NEWS_PATH[locale]], [title, paths[locale]]];
const shared = cover && (await getImage({ src: cover, width: 1200, height: 630, fit: "cover", position: "top", format: "jpg" }));
const image = shared ? { src: shared.src, width: 1200, height: 630 } : undefined;
const card = image ?? cardOf(product, locale);
const url = canonical(locale, paths[locale]);
const posting = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: story.date,
  inLanguage: locale,
  url,
  mainEntityOfPage: url,
  author: { "@id": PERSON_ID },
  publisher: { "@id": PERSON_ID },
  about: { "@id": appId(product.slug) },
  ...(card ? { image: new URL(card.src, DOMAIN).toString() } : {}),
};
const neighbour = "block rounded-3xl border border-line p-5 transition-colors hover:border-fg/30";
---

<Layout title={title} description={description} locale={locale} paths={paths} published={story.date} image={image} schema={[crumbs(locale, trail), posting]}>
  <article class="shell pt-10 sm:pt-14" style={`--accent: ${product.accent}`}>
    <Crumbs locale={locale} trail={trail} />
    <header class="mt-10 max-w-3xl">
      <p class="eyebrow">{t.short}</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-[-0.03em] sm:text-5xl">{title}</h1>
      <p class="mt-4 text-sm text-muted"><time datetime={story.date}>{longDate(story.date, locale)}</time></p>
    </header>

    <div class="prose prose-lg mt-10 max-w-3xl">
      <Content />
    </div>

    <aside class="mt-12 max-w-3xl rounded-3xl border border-line bg-sunken/60 p-6 sm:p-8">
      <p class="text-body">{t.updates}</p>
      <a class="btn-primary mt-5" href={`${href(locale)}#download`}>{t.download}</a>
    </aside>

    <nav aria-label={t.short} class="mt-12 grid max-w-3xl gap-4 sm:grid-cols-2">
      {
        older && (
          <a class={neighbour} href={href(locale, storyPath(locale, older.page[locale]))}>
            <span class="text-sm text-muted">{t.older}</span>
            <span class="mt-1 block font-medium text-fg">{older.article[locale].data.title}</span>
          </a>
        )
      }
      {
        newer && (
          <a class={`${neighbour} sm:col-start-2 sm:text-right`} href={href(locale, storyPath(locale, newer.page[locale]))}>
            <span class="text-sm text-muted">{t.newer}</span>
            <span class="mt-1 block font-medium text-fg">{newer.article[locale].data.title}</span>
          </a>
        )
      }
    </nav>
  </article>
</Layout>
