---
interface Props {
  avif: string;
  webp: string;
  fallback: string;
  width?: number;
  height?: number;
  alt: string;
  sizes: string;
  later?: boolean;
}

const { avif, webp, fallback, width, height, alt, sizes, later = false } = Astro.props;
const source = later ? { "data-srcset": avif } : { srcset: avif };
const image = later ? { "data-src": fallback, "data-srcset": webp } : { src: fallback, srcset: webp };
---

<picture class="contents">
  <source type="image/avif" sizes={sizes} {...source} />
  <img
    {...image}
    sizes={sizes}
    width={width}
    height={height}
    alt={alt}
    loading={later ? undefined : "lazy"}
    fetchpriority="low"
    decoding="async"
    class="h-full w-auto max-w-full rounded-md border border-white/10 shadow-[0_24px_50px_-24px_rgb(40_25_5/0.55)] sm:rounded-lg"
  />
</picture>
