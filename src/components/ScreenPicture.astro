---
interface Props {
  avif: string;
  webp: string;
  fallback: string;
  width?: number;
  height?: number;
  alt: string;
  sizes: string;
  later?: boolean;
  /// Fetched first, though still only the one the theme shows.
  priority?: boolean;
}

const { avif, webp, fallback, width, height, alt, sizes, later = false, priority = false } = Astro.props;
const source = later ? { "data-srcset": avif } : { srcset: avif };
const image = later ? { "data-src": fallback, "data-srcset": webp } : { src: fallback, srcset: webp };
---

<picture class="contents">
  <source type="image/avif" sizes={sizes} {...source} />
  <img
    {...image}
    sizes={sizes}
    width={width}
    height={height}
    alt={alt}
    loading={later ? undefined : "lazy"}
    fetchpriority={priority ? "high" : "low"}
    decoding="async"
    class="max-h-full max-w-full drop-shadow-[0_14px_12px_rgb(40_25_5/0.3)]"
  />
</picture>
