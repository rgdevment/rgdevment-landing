---
import { Code } from "astro:components";
import Icon from "./Icon.astro";
import type { Proof } from "../content/products";

interface Props {
  proof: Proof;
}

const { proof } = Astro.props;
const panel = "overflow-hidden rounded-3xl border border-line bg-night";
const caption = "flex items-center justify-between gap-3 border-b border-night-line px-5 py-3 font-mono text-xs text-stone-400";
---

<section class="shell mt-24 sm:mt-32">
  <h2 class="section-title">{proof.title}</h2>
  <p class="mt-3 max-w-3xl text-muted">{proof.lede}</p>

  <div class="mt-10 grid grid-cols-1 gap-4 lg:grid-cols-2">
    <figure class={panel}>
      <figcaption class={caption}>
        <span>{proof.doc.name}</span>
        <span>Markdown</span>
      </figcaption>
      <Code code={proof.doc.body} lang="md" theme="github-dark" class="!bg-transparent px-5 py-4 text-[13px] leading-relaxed" />
    </figure>

    <div class="grid min-w-0 grid-cols-1 gap-4">
      <figure class={panel}>
        <figcaption class={caption}>
          <span>{proof.tree.title}</span>
        </figcaption>
        <pre class="overflow-x-auto px-5 py-4 font-mono text-[13px] leading-relaxed text-stone-100">{proof.tree.body}</pre>
        <p class="px-5 pb-4 text-xs text-stone-400">{proof.tree.note}</p>
      </figure>

      <figure class={panel}>
        <figcaption class={caption}>
          <span>{proof.log.name}</span>
          <span>JSONL</span>
        </figcaption>
        <pre class="overflow-x-auto px-5 py-4 font-mono text-[12px] leading-relaxed text-stone-100">{proof.log.body}</pre>
        <p class="px-5 pb-4 text-xs text-stone-400">{proof.log.note}</p>
      </figure>
    </div>
  </div>

  <p class="mt-6 max-w-3xl font-display text-lg text-fg">{proof.editors}</p>
  <p class="mt-2 max-w-3xl text-body">
    {proof.share.line}
    <a class="ml-1 inline-flex items-center gap-1 font-medium text-fg hover:underline" href={proof.share.url} rel="noopener">
      {proof.share.link}
      <Icon name="arrow" class="h-3.5 w-3.5" />
    </a>
  </p>
</section>
