---
import ScreenPicture from "./ScreenPicture.astro";
import type { Screen } from "../content/products";
import { SCREEN_SIZES, shadesOf } from "../screens";

interface Props {
  screen: Screen;
  sizes?: string;
  priority?: boolean;
  class?: string;
}

const { screen, sizes = SCREEN_SIZES, priority = false, class: className } = Astro.props;
const shades = await shadesOf(screen);
const { width, height } = shades[0].picture;
---

<div class:list={["flex items-center justify-center", className]} style={`aspect-ratio: ${width} / ${height}`}>
  {
    shades.map(({ shade, picture }) => (
      <div class="contents" data-shade={shade}>
        <ScreenPicture {...picture} sizes={sizes} priority={priority} />
      </div>
    ))
  }
</div>
