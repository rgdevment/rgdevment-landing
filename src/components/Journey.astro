---
import type { JourneyStep } from "../content/products";

interface Props {
  steps: JourneyStep[];
  accent: string;
}

const { steps, accent } = Astro.props;
---

<ol class="mt-8 grid grid-cols-1 gap-10 lg:grid-cols-4 lg:gap-8">
  {
    steps.map((step, at) => (
      <li class="relative flex flex-col">
        <div class="flex items-center gap-3">
          <span
            class="grid h-8 w-8 shrink-0 place-items-center rounded-full font-mono text-sm font-semibold text-white"
            style={`background: ${accent}`}
          >
            {at + 1}
          </span>
          <h4 class="font-display text-lg font-semibold text-fg">{step.label}</h4>
        </div>

        <div class="mt-4 rounded-2xl border border-line bg-sunken p-3.5 font-mono text-[12.5px] leading-relaxed">
          <ul class="space-y-1.5">
            {step.shows.map(([mark, text]) => (
              <li class:list={["flex items-start gap-2", mark === "note" ? "text-muted" : "text-fg"]}>
                {mark === "todo" && <span class="mt-[3px] h-3 w-3 shrink-0 rounded-[3px] border border-muted" aria-hidden="true" />}
                {mark === "done" && (
                  <span class="mt-[3px] grid h-3 w-3 shrink-0 place-items-center rounded-[3px] text-white" style={`background: ${accent}`} aria-hidden="true">
                    <svg viewBox="0 0 12 12" class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="2"><path d="M2.5 6.2 5 8.5l4.5-5" /></svg>
                  </span>
                )}
                {mark === "note" && <span class="shrink-0" aria-hidden="true">›</span>}
                {mark === "archived" && (
                  <svg viewBox="0 0 16 16" class="mt-[2px] h-3.5 w-3.5 shrink-0 text-muted" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <rect x="1.5" y="2.5" width="13" height="3.5" rx="1" />
                    <path d="M2.5 6v6.5a1 1 0 0 0 1 1h9a1 1 0 0 0 1-1V6M6.5 9h3" />
                  </svg>
                )}
                {mark === "search" && (
                  <svg viewBox="0 0 16 16" class="mt-[2px] h-3.5 w-3.5 shrink-0 text-muted" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <circle cx="7" cy="7" r="4.5" />
                    <path d="m10.5 10.5 3.5 3.5" />
                  </svg>
                )}
                {mark === "found" && <span class="mt-[5px] h-2 w-2 shrink-0 rounded-full" style={`background: ${accent}`} aria-hidden="true" />}
                <span class:list={["min-w-0", { "rounded bg-surface px-1.5": mark === "search" }]}>{text}</span>
              </li>
            ))}
          </ul>
        </div>

        <p class="mt-3 text-body">{step.body}</p>

        {at < steps.length - 1 && (
          <span
            class="absolute -bottom-8 left-4 grid h-6 w-6 place-items-center text-muted lg:-right-7 lg:bottom-auto lg:left-auto lg:top-1 lg:h-6 lg:w-6"
            aria-hidden="true"
          >
            <svg viewBox="0 0 24 24" class="h-5 w-5 rotate-90 lg:rotate-0" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 12h15M13 6l6 6-6 6" />
            </svg>
          </span>
        )}
      </li>
    ))
  }
</ol>
