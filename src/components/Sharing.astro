---
import Icon from "./Icon.astro";
import { docPath } from "../content/docs";
import { inkOf, type Product, type Sharing } from "../content/products";
import { href, type Locale } from "../site";

interface Props {
  product: Product;
  words: Sharing;
  locale: Locale;
}

const { product, words, locale } = Astro.props;
---

<section id="folio" class="shell mt-24 scroll-mt-24 sm:mt-32">
  <h2 class="section-title">{words.title}</h2>
  <p class="mt-3 text-muted">{words.lede}</p>

  <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      words.points.map((one) => (
        <div class="card p-6">
          <h3 class="accent-ink text-lg font-semibold" style={inkOf(product)}>{one.title}</h3>
          <p class="mt-2 text-sm text-body">{one.body}</p>
        </div>
      ))
    }
  </div>

  <div class="mt-4 flex flex-col gap-4 rounded-3xl border border-flame/25 bg-flame-tint p-6 sm:flex-row sm:items-center sm:p-7">
    <span class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-surface text-flame-ink">
      <Icon name="lock" class="h-5 w-5" />
    </span>
    <p class="text-body">{words.caveat}</p>
  </div>

  <p class="mt-6 text-body">
    {words.home}
    <a class="ml-1 font-medium text-fg underline decoration-muted underline-offset-4 hover:decoration-fg" href={words.site} rel="noopener">{new URL(words.site).host}</a>
  </p>

  <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm">
    {
      words.papers.map(([name, url]) => (
        <a class="chip transition hover:border-fg/25 hover:text-fg" href={url} rel="noopener">{name}</a>
      ))
    }
  </div>

  <a
    class="mt-6 inline-flex items-center gap-1.5 font-medium text-fg hover:underline"
    href={`${href(locale, docPath(locale, product.slug, words.page))}#${words.anchor}`}
  >
    {words.more}
    <Icon name="arrow" class="h-4 w-4" />
  </a>
</section>
