---
import Copy from "./Copy.astro";
import Crumbs from "./Crumbs.astro";
import Download from "./Download.astro";
import Faq from "./Faq.astro";
import Icon from "./Icon.astro";
import Install from "./Install.astro";
import Shot from "./Shot.astro";
import WritingMark from "./WritingMark.astro";
import Layout from "../layouts/Layout.astro";
import { changelogUrl, hasChangelog } from "../content/changelog";
import { COMPARE_PATH, comparisonOf } from "../content/compare";
import { bySection, docPath, docsOf } from "../content/docs";
import { privacyPath } from "../content/privacy";
import { GUIDES, written } from "../content/guides";
import { PRODUCTS, type Product, cardOf, inkOf, shotSrc, words, iconAlt } from "../content/products";
import { latestRelease, releaseDate, stars } from "../content/releases";
import { appSchema, faqSchema } from "../content/schema";
import { DOMAIN, HOME_PRODUCT, canonical, crumbs, href, type Locale } from "../site";

interface Props {
  product: Product;
  locale: Locale;
}

const { product, locale } = Astro.props;
const t = words(product, locale);
const compared = comparisonOf(product.slug);
const compare = compared && { label: compared[locale].heading, path: COMPARE_PATH[locale] };
const es = locale === "es";
const path = product.slug;
const shot = shotSrc(product, locale);
const ink = inkOf(product);
const social = cardOf(product, locale);

const release = await latestRelease(product);
const starCount = product.signals ? await stars(product) : null;
const licence = `${product.repo}/blob/main/LICENSE`;
const docs = await docsOf(product.slug, locale);
const docIndex = docPath(locale, product.slug);
const docSections = bySection(docs);
const guides = GUIDES.filter((one) => one.product === product.slug);
const others = PRODUCTS.filter((one) => one.slug !== product.slug);

const say = {
  guides: es ? "Guías" : "Guides",
  guidesLede: es ? "Para sacarle partido, o para resolver el problema sin instalar nada." : "To get more out of it, or to solve the problem without installing anything.",
  privacy: es ? "Privacidad" : "Privacy",
  policy: es ? "Leer la política de privacidad" : "Read the privacy policy",
  source: es ? "Ver el código fuente" : "View the source code",
  free: es ? "Gratis y de código abierto" : "Free and open source",
  onGithub: es ? "Código fuente en GitHub" : "Source code on GitHub",
  stars: es ? "Estrellas en GitHub" : "Stars on GitHub",
  differs: es ? `¿Qué diferencia a ${product.name} de otros?` : `What sets ${product.name} apart from others?`,
  others: es ? "Del mismo taller" : "From the same workshop",
  notes: es ? "Notas de la versión" : "Release notes",
  docs: es ? "Ayuda" : "Documentation",
  docsLede: es ? `Todo lo que hace ${product.name}, paso a paso.` : `Everything ${product.name} does, step by step.`,
  docsGo: es ? "Toda la ayuda" : "All the docs",
  noAccount: es ? `Sin cuenta de ${product.name}` : `No ${product.name} account`,
  noTelemetry: es ? "Sin telemetría" : "No telemetry",
};

const help = docs.length > 0 ? canonical(locale, docPath(locale, product.slug)) : product.repo;
const schema = [
  appSchema(product, locale, release, help, shot && new URL(shot, DOMAIN).toString()),
  faqSchema(t.faq),
  ...(HOME_PRODUCT ? [] : [crumbs(locale, [[product.name, path]])]),
];
---

<Layout
  title={t.title ?? `${product.name} - ${t.tagline}`}
  description={t.meta}
  image={social}
  locale={locale}
  path={path}
  here={product.slug}
  schema={schema}
>
  <section class="relative isolate overflow-hidden" style={`--accent: ${product.accent}`}>
    <div
      class="pointer-events-none absolute -top-40 left-1/2 -z-10 h-[34rem] w-[60rem] -translate-x-1/2 rounded-full opacity-[0.16] blur-3xl"
      style="background: radial-gradient(closest-side, var(--accent), transparent)"
      aria-hidden="true"
    ></div>
    <div class="dotgrid absolute inset-0 -z-10" aria-hidden="true"></div>

    <div class="shell pt-6 sm:pt-14">
      <Crumbs locale={locale} trail={[[product.name, path]]} />

      <header class="mx-auto mt-8 max-w-5xl text-center sm:mt-12">
        {
          product.writes ? (
            <WritingMark class="mx-auto h-20 w-20 sm:h-32 sm:w-32" />
          ) : (
            <img
              src={product.icon}
              alt={iconAlt(product, locale)}
              width="96"
              height="96"
              class="mx-auto h-20 w-20 rounded-[1.4rem] shadow-[0_18px_40px_-16px_rgb(0_0_0/0.5)] sm:h-24 sm:w-24"
            />
          )
        }
        <h1 class="mt-7 text-5xl font-semibold tracking-[-0.03em] sm:text-6xl">
          {product.name}<span class="sr-only">: </span>
          <span class="mt-3 block text-base font-medium tracking-normal text-muted sm:text-lg">{t.category}</span>
        </h1>
        <p class="mt-4 text-xl text-fg sm:text-2xl">{t.tagline}</p>
        {t.formerly && <p class="mt-3 text-sm text-muted">{t.formerly}</p>}
        <p class="mx-auto mt-5 max-w-4xl text-lg text-body">{t.problem}</p>

        {
          release && (
            <p class="mt-6">
              <a
                class="chip text-xs transition hover:border-fg/25"
                href={hasChangelog(product.slug) ? changelogUrl(product, locale, release.version) : release.url}
                title={say.notes}
              >
                <span class="h-1.5 w-1.5 rounded-full bg-flame" aria-hidden="true" />
                v{release.version} · {releaseDate(release, locale)}
              </a>
            </p>
          )
        }

        <div class="flex flex-col">

        <Download
          product={product}
          locale={locale}
          release={release}
          docs={docs.length > 0 ? href(locale, docIndex) : undefined}
          compare={compare && { label: say.differs, path: compare.path, ink }}
        />
        <ul class="mt-7 flex flex-wrap justify-center gap-2 sm:order-first">
          {
            product.platforms.map((one) => (
              <li class="chip">
                <Icon name={one === "Windows" ? "windows" : "apple"} class="h-3.5 w-3.5" />
                {one}
              </li>
            ))
          }
          <li class="chip"><Icon name="lock" class="h-3.5 w-3.5" />{say.noAccount}</li>
          <li class="chip"><Icon name="eye" class="h-3.5 w-3.5" />{say.noTelemetry}</li>
          <li>
            <a class="chip transition hover:border-fg/25 hover:text-fg" href={licence} rel="noopener">
              <Icon name="licence" class="h-3.5 w-3.5" />{product.licence}
            </a>
          </li>
          <li class="chip border-flame/30 bg-flame-tint font-medium text-flame-ink">
            <Icon name="free" class="h-3.5 w-3.5" />{say.free}
          </li>
          {
            product.signals && (
              <li>
                <a class="chip transition hover:border-fg/25 hover:text-fg" href={product.repo} rel="noopener">
                  <Icon name="github" class="h-3.5 w-3.5" />
                  {say.onGithub}
                  {starCount !== null && (
                    <span class="inline-flex items-center gap-1 border-l border-line pl-2 text-xs" title={say.stars}>
                      <Icon name="star" class="h-3 w-3" />
                      {starCount}
                    </span>
                  )}
                </a>
              </li>
            )
          }
        </ul>
        </div>
      </header>

      {
        product.shot && (
          <div class="relative mx-auto mt-16 max-w-5xl">
            <div
              class="absolute inset-x-10 -bottom-6 top-10 -z-10 rounded-[2rem] opacity-30 blur-3xl"
              style="background: var(--accent)"
              aria-hidden="true"
            />
            <div class="rounded-[1.75rem] border border-line bg-night p-2 shadow-2xl sm:p-3">
              <Shot product={product} locale={locale} eager class="w-full rounded-[1.25rem]" />
            </div>
          </div>
        )
      }
    </div>
  </section>

  <section class="shell mt-24 sm:mt-32">
    <h2 class="section-title">{es ? `Qué hace ${product.name}` : `What ${product.name} does`}</h2>
    {
      compare && (
        <a class="mt-6 inline-flex items-center gap-1.5 font-medium text-fg hover:underline" href={href(locale, compare.path)}>
          {compare.label}
          <Icon name="arrow" class="h-4 w-4" />
        </a>
      )
    }
    {
      t.what && (
        <ol class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2">
          {t.what.map((one, at) => (
            <li class="card relative p-6 sm:p-7">
              <span class="accent-ink text-sm font-medium" style={ink}>
                {String(at + 1).padStart(2, "0")}
              </span>
              <p class="mt-3 text-body">{one}</p>
            </li>
          ))}
        </ol>
      )
    }
  </section>

  {
    product.mascot && t.mascot && (
      <section class="shell mt-16">
        <div class="card flex flex-col items-center gap-6 p-7 text-center sm:flex-row sm:p-9 sm:text-left">
          <img src={product.mascot} alt={es ? `Mascota de ${product.name}` : `${product.name}'s mascot`} width="120" height="108" loading="lazy" class="h-24 w-auto shrink-0 sm:h-28" />
          <div>
            <h2 class="text-2xl font-semibold">{t.mascot.title}</h2>
            <p class="mt-2 text-body">{t.mascot.body}</p>
          </div>
        </div>
      </section>
    )
  }

  <section class="shell mt-16">
    <div class="flex flex-col gap-5 rounded-3xl border border-flame/25 bg-flame-tint p-7 sm:flex-row sm:items-center sm:p-9">
      <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-surface text-flame-ink">
        <Icon name="shield" class="h-6 w-6" />
      </span>
      <div>
        <h2 class="text-xl font-semibold">{say.privacy}</h2>
        <p class="mt-1.5 text-body">{t.privacy}</p>
        <a class="mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-flame-ink hover:underline" href={href(locale, privacyPath(locale, product.slug))}>
          {say.policy}
        </a>
      </div>
    </div>
  </section>

  <Install product={product} locale={locale} />

  {
    docs.length > 0 && (
      <section class="shell mt-24 sm:mt-32">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div>
            <h2 class="section-title">{say.docs}</h2>
            <p class="mt-3 text-muted">{say.docsLede}</p>
          </div>
          <a class="inline-flex items-center gap-1.5 font-medium text-fg hover:underline" href={href(locale, docIndex)}>
            {say.docsGo}
            <Icon name="arrow" class="h-4 w-4" />
          </a>
        </div>
        <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {docSections.map(([section, list]) => (
            <div class="card p-6">
              <h3 class="eyebrow">{section}</h3>
              <ul class="mt-4 space-y-2">
                {list.map((one) => (
                  <li>
                    <a class="text-body transition-colors hover:text-fg" href={href(locale, docPath(locale, product.slug, one.data.page))}>
                      {one.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <Faq locale={locale} questions={t.faq} />

  {
    guides.length > 0 && (
      <section class="shell mt-24 sm:mt-32">
        <h2 class="section-title">{say.guides}</h2>
        <p class="mt-3 text-muted">{say.guidesLede}</p>
        <ul class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
          {guides.map((one) => (
            <li>
              <a class="card-link group block h-full p-6" href={href(locale, written(one, locale).slug)}>
                <span class="flex items-start justify-between gap-4">
                  <span class="text-lg font-semibold leading-snug text-fg">{written(one, locale).title}</span>
                  <Icon name="arrow" class="mt-1 h-4 w-4 shrink-0 text-muted transition group-hover:translate-x-0.5" />
                </span>
                <span class="mt-2 block text-sm text-muted">{written(one, locale).description}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="shell mt-24 sm:mt-32">
    <div class="flex flex-wrap items-center justify-between gap-4 border-t border-line pt-10">
      <h2 class="eyebrow">{say.others}</h2>
      <a class="inline-flex items-center gap-2 text-sm text-muted transition-colors hover:text-fg" href={product.repo} rel="noopener">
        <Icon name="github" class="h-4 w-4" />
        {say.source}
      </a>
    </div>
    <ul class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
      {
        others.map((one) => (
          <li>
            <a class="card-link group flex items-center gap-4 p-5" href={href(locale, one.slug)}>
              <img src={one.icon} alt={iconAlt(one, locale)} width="48" height="48" class="h-12 w-12 rounded-xl" loading="lazy" />
              <span class="min-w-0">
                <span class="block text-lg font-semibold text-fg">{one.name}</span>
                <span class="block text-sm text-muted">{words(one, locale).tagline}</span>
              </span>
              <Icon name="arrow" class="ml-auto h-4 w-4 shrink-0 text-muted transition group-hover:translate-x-0.5" />
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <Copy />
</Layout>
