---
import Crumbs from "./Crumbs.astro";
import Icon from "./Icon.astro";
import Layout from "../layouts/Layout.astro";
import { CHANGELOG_PATH, FEED, changelogWords, notesOf } from "../content/changelog";
import { PRODUCTS, releasesUrl } from "../content/products";
import { HOME_PRODUCT, crumbs, type Locale } from "../site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const product = PRODUCTS.find((one) => one.slug === HOME_PRODUCT)!;
const t = changelogWords(product, locale);
const path = CHANGELOG_PATH[locale];
const trail: [string, string][] = [[product.name, ""], [t.short, path]];
const notes = await notesOf(product);
const written = locale === "en" ? undefined : "en";
const day = (date: string) =>
  new Date(date).toLocaleDateString(locale === "es" ? "es-CL" : "en-US", { year: "numeric", month: "long", day: "numeric" });
---

<Layout title={t.title} description={t.meta} locale={locale} textIn="en" paths={CHANGELOG_PATH} schema={crumbs(locale, trail)}>
  <section class="shell pt-10 sm:pt-14" style={`--accent: ${product.accent}`}>
    <Crumbs locale={locale} trail={trail} />
    <header class="mt-10">
      <p class="eyebrow">{t.short}</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-[-0.03em] sm:text-5xl">{t.title}</h1>
      <p class="mt-5 text-lg text-body">{t.lede}</p>
      {t.english && <p class="mt-3 text-sm text-muted">{t.english}</p>}
      <p class="mt-6">
        <a class="inline-flex items-center gap-1.5 font-medium text-fg hover:underline" href={`/${FEED}`} type="application/rss+xml">
          {t.feed}
          <Icon name="arrow" class="h-4 w-4" />
        </a>
      </p>
    </header>

    <ol class="mt-12 max-w-3xl divide-y divide-line">
      {
        notes.map((one) => (
          <li id={`v${one.version}`} class="scroll-mt-24 py-10 first:pt-0">
            <h2 class="font-display text-2xl font-semibold tracking-[-0.02em] text-fg">
              <a class="hover:underline" href={`#v${one.version}`}>{one.version}</a>
            </h2>
            <p class="mt-1 text-sm text-muted">
              <time datetime={one.date}>{day(one.date)}</time>
              <span class="px-2" aria-hidden="true">·</span>
              <a class="underline decoration-muted underline-offset-4 hover:text-fg" href={one.url} rel="noopener">{t.github}</a>
            </p>
            {one.headline && <p class="mt-4 text-lg font-medium text-fg" lang={written}>{one.headline}</p>}
            <div class="prose mt-4" lang={written} set:html={one.html} />
          </li>
        ))
      }
    </ol>

    <a class="btn-ghost mt-6" href={releasesUrl(product)} rel="noopener">{t.older}</a>
  </section>
</Layout>
