---
import { render } from "astro:content";
import Crumbs from "./Crumbs.astro";
import DocNav from "./DocNav.astro";
import Icon from "./Icon.astro";
import Layout from "../layouts/Layout.astro";
import { bySection, type Doc, docPath, docsOf } from "../content/docs";
import { PRODUCTS, cardOf, inkOf, iconAlt } from "../content/products";
import { AUTHOR, DOMAIN, HOME_PRODUCT, PERSON_ID, WEBSITE_ID, appId, canonical, crumbs, href, type Locale } from "../site";

interface Props {
  doc: Doc;
  locale: Locale;
}

const { doc, locale } = Astro.props;
const es = locale === "es";
const data = doc.data;
const hasMath = /\$\$|^```math/m.test(doc.body ?? "");
const product = PRODUCTS.find((one) => one.slug === data.product)!;
const { Content, headings } = await render(doc);

const siblings = await docsOf(product.slug, locale);
const at = siblings.findIndex((one) => one.id === doc.id);
const prev = at > 0 ? siblings[at - 1] : undefined;
const next = siblings[at + 1];

const sections = bySection(siblings);

const say = {
  docs: es ? "Ayuda" : "Docs",
  overview: es ? "Inicio" : "Overview",
  title: es ? `Ayuda de ${product.name}` : `${product.name} documentation`,
  toc: es ? "En esta página" : "On this page",
  edit: es ? "Editar en GitHub" : "Edit on GitHub",
  prev: es ? "Anterior" : "Previous",
  next: es ? "Siguiente" : "Next",
  menu: es ? "Índice de la ayuda" : "Docs contents",
  source: es ? "Código fuente" : "Source code",
  reference: es ? "Referencia" : "Reference",
  open: es ? "Abrir la referencia" : "Open the reference",
  copy: es ? "Copiar" : "Copy",
  copied: es ? "Copiado" : "Copied",
};

const index = docPath(locale, product.slug);
const path = docPath(locale, product.slug, data.page);
const other: Locale = es ? "en" : "es";
const paths = { [locale]: path, [other]: docPath(other, product.slug, data.twin ?? "") };
const heading = data.page ? data.title : say.title;
const title = data.page ? `${data.title} · ${es ? `Ayuda de ${product.name}` : `${product.name} docs`}` : say.title;
const trail: [string, string][] = [
  [product.name, product.slug],
  [say.docs, index],
  ...(data.page ? [[data.title, path] as [string, string]] : []),
];
const toc = headings.filter((one) => one.depth === 2);
const linkOf = (one: Doc) => href(locale, docPath(locale, product.slug, one.data.page));
const overview = { label: say.overview, href: href(locale, index), on: !data.page };
const source = HOME_PRODUCT === product.slug ? { label: say.source, href: product.repo } : undefined;
const words = product[locale].language;
const language = words && { eyebrow: say.reference, label: words.title, href: words.url };
const promote = words && (!data.page || ["Documents", "Documentos"].includes(data.section));

const card = cardOf(product, locale);
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: heading,
    description: data.description,
    inLanguage: locale,
    dateModified: data.updated,
    author: { "@id": PERSON_ID, "@type": "Person", name: AUTHOR.name },
    publisher: { "@id": PERSON_ID },
    isPartOf: { "@id": WEBSITE_ID },
    mainEntityOfPage: canonical(locale, path),
    about: { "@id": appId(product.slug) },
    ...(card ? { image: new URL(card.src, DOMAIN).toString() } : {}),
    ...(promote ? { mentions: { "@type": "TechArticle", headline: words.title, url: words.url, inLanguage: locale } } : {}),
  },
  crumbs(locale, trail),
];
---

<Layout
  title={title}
  description={data.description || heading}
  locale={locale}
  path={path}
  paths={paths}
  here={product.slug}
  modified={data.updated}
  schema={schema}
>
  {hasMath && <link slot="head" rel="stylesheet" href={import.meta.env.KATEX_CSS} />}
  <div class="shell pt-10 sm:pt-14">
    <Crumbs locale={locale} trail={trail} />

    <div class="mt-10 grid gap-10 lg:grid-cols-[15rem_minmax(0,1fr)] xl:grid-cols-[15rem_minmax(0,1fr)_12rem]">
      <aside class="lg:sticky lg:top-24 lg:flex lg:max-h-[calc(100vh-7rem)] lg:flex-col lg:self-start">
        <div class="doc-search invisible mb-6 min-h-[3.25rem] shrink-0 lg:pr-3" data-search></div>
        <details class="group card lg:hidden">
          <summary class="flex cursor-pointer list-none items-center gap-3 p-4 [&::-webkit-details-marker]:hidden">
            <img src={product.icon} alt={iconAlt(product, locale)} width="28" height="28" class="h-7 w-7 rounded-lg" />
            <span class="font-semibold text-fg">{say.title}</span>
            <Icon name="chevron" class="ml-auto h-4 w-4 text-muted transition group-open:rotate-180" />
          </summary>
          <nav aria-label={say.menu} class="px-1 pb-4 text-[15px]">
            <DocNav current={doc.id} overview={overview} sections={sections} linkOf={linkOf} language={language} source={source} />
          </nav>
        </details>
        <div class="hidden min-h-0 lg:block lg:overflow-y-auto lg:pb-6 lg:pr-3">
          <a href={href(locale, product.slug)} class="flex items-center gap-3">
            <img src={product.icon} alt={iconAlt(product, locale)} width="28" height="28" class="h-7 w-7 rounded-lg" />
            <span class="font-semibold text-fg">{product.name}</span>
          </a>
          <nav aria-label={say.menu} class="mt-6 text-[15px]">
            <DocNav current={doc.id} overview={overview} sections={sections} linkOf={linkOf} language={language} source={source} />
          </nav>
        </div>
      </aside>

      <article class="min-w-0">
        <div data-pagefind-body>
          <header class="border-b border-line pb-8">
            {data.page && <p class="eyebrow">{data.section}</p>}
            <h1 class="mt-3 text-4xl font-semibold tracking-[-0.02em] sm:text-5xl">{heading}</h1>
            {data.description && <p class="mt-5 text-lg text-body">{data.description}</p>}
          </header>

          <div class="prose prose-lg mt-8" data-copy={say.copy} data-copied={say.copied}>
            <Content />
          </div>
        </div>

        {
          promote && (
            <a class="card-link group mt-12 flex items-start gap-5 p-6 sm:p-7" href={words.url} style={`--accent: ${product.accent}; ${inkOf(product)}`}>
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl text-white" style="background: var(--accent)">
                <Icon name="code" class="h-5 w-5" />
              </span>
              <span class="min-w-0">
                <span class="eyebrow text-[11px]">{say.reference}</span>
                <span class="mt-1 block text-xl font-semibold text-fg">{words.title}</span>
                <span class="mt-2 block text-body">{words.line}</span>
                <span class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-fg">
                  {say.open}
                  <span class="accent-ink">
                    <Icon name="arrow" class="h-4 w-4 transition group-hover:translate-x-0.5" />
                  </span>
                </span>
              </span>
            </a>
          )
        }

        <nav class="mt-16 grid gap-4 border-t border-line pt-8 sm:grid-cols-2" aria-label={es ? "Paginación" : "Pagination"}>
          {
            prev ? (
              <a class="card-link group p-5" href={linkOf(prev)}>
                <span class="text-sm text-muted">{say.prev}</span>
                <span class="mt-1 block font-semibold text-fg">{prev.data.page ? prev.data.title : say.overview}</span>
              </a>
            ) : (
              <span />
            )
          }
          {
            next && (
              <a class="card-link group p-5 text-right" href={linkOf(next)}>
                <span class="text-sm text-muted">{say.next}</span>
                <span class="mt-1 block font-semibold text-fg">{next.data.title}</span>
              </a>
            )
          }
        </nav>

        <p class="mt-8 text-sm">
          <a class="inline-flex items-center gap-2 text-muted transition-colors hover:text-fg" href={data.source} rel="noopener">
            <Icon name="github" class="h-4 w-4" />
            {say.edit}
          </a>
        </p>
      </article>

      {
        toc.length > 1 && (
          <aside class="hidden xl:block">
            <nav aria-label={say.toc} class="sticky top-24 text-sm">
              <p class="eyebrow text-[11px]">{say.toc}</p>
              <ul class="mt-3 space-y-2 border-l border-line">
                {toc.map((one) => (
                  <li>
                    <a class="-ml-px block border-l border-transparent pl-4 text-muted transition-colors hover:border-fg hover:text-fg" href={`#${one.slug}`}>
                      {one.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )
      }
    </div>
  </div>
  <script>
    const prose = document.querySelector<HTMLElement>("[data-copy]");
    for (const pre of prose?.querySelectorAll<HTMLElement>("pre:not(:has(> code.language-mermaid))") ?? []) {
      const box = document.createElement("div");
      box.className = "code-box";
      const button = document.createElement("button");
      button.type = "button";
      button.className = "copy";
      button.textContent = prose!.dataset.copy ?? "";
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText((pre.querySelector("code") ?? pre).innerText);
          button.textContent = prose!.dataset.copied ?? "";
          const said = document.querySelector("[data-announce]");
          if (said) said.textContent = prose!.dataset.copied ?? "";
          setTimeout(() => (button.textContent = prose!.dataset.copy ?? ""), 1500);
        } catch {}
      });
      pre.replaceWith(box);
      box.append(pre, button);
    }

    const search = document.querySelector<HTMLElement>("[data-search]");
    if (search) {
      const load = () => {
        const sheet = document.createElement("link");
        sheet.rel = "stylesheet";
        sheet.href = "/pagefind/pagefind-ui.css";
        const code = document.createElement("script");
        code.src = "/pagefind/pagefind-ui.js";
        code.onload = () => {
          const { PagefindUI } = window as unknown as { PagefindUI: new (options: object) => unknown };
          new PagefindUI({ element: search, showSubResults: true, showImages: false, resetStyles: false });
          search.classList.remove("invisible");
        };
        document.head.append(sheet, code);
      };
      if ("requestIdleCallback" in window) requestIdleCallback(load, { timeout: 2000 });
      else setTimeout(load, 200);
    }

    const blocks = [...document.querySelectorAll<HTMLElement>("pre > code.language-mermaid")];
    if (blocks.length) {
      // Held in a variable so the bundler leaves it to the browser instead of trying to resolve it.
      const mermaidUrl: string = import.meta.env.MERMAID_URL;
      const root = document.documentElement;
      const dark = () => (root.dataset.theme ?? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light")) === "dark";
      const arrival = performance.getEntriesByType("navigation")[0] as PerformanceNavigationTiming | undefined;
      // A jump counts until the reader takes over; a reload or going back restores their own position instead.
      let jumping = location.hash !== "" && arrival?.type === "navigate";
      addEventListener("hashchange", () => (jumping = true));
      document.addEventListener("click", (event) => {
        if ((event.target as Element).closest?.('a[href^="#"]')) jumping = true;
      });
      for (const input of ["wheel", "touchstart", "pointerdown", "keydown"]) {
        addEventListener(input, () => (jumping = false), { capture: true, passive: true });
      }
      // A diagram that grows moves everything below it: a jump in progress must land again, and browsers without scroll anchoring need the place held.
      const holdingPlace = async (change: () => void | Promise<void>) => {
        const anchored = CSS.supports("overflow-anchor", "auto");
        const anchor = [...(prose?.children ?? [])].find((one) => !one.matches("pre, .mermaid") && one.getBoundingClientRect().bottom > 0);
        const offset = () => (anchor?.getBoundingClientRect().top ?? 0) + scrollY;
        const before = offset();
        try {
          await change();
        } finally {
          const target = jumping ? document.querySelector(":target") : null;
          jumping = false;
          if (target) target.scrollIntoView();
          else if (!anchored && offset() !== before) scrollBy({ top: offset() - before, behavior: "instant" });
        }
      };
      const near = new IntersectionObserver(
        async (seen) => {
          if (!seen.some((one) => one.isIntersecting)) return;
          near.disconnect();
          // The source stays on the page until the module arrives, so a failed download leaves it readable.
          const mermaid = await import(/* @vite-ignore */ mermaidUrl).then((one) => one.default, () => null);
          if (!mermaid) return;
          let nodes: HTMLElement[] = [];
          const draw = () =>
            holdingPlace(async () => {
              nodes = nodes.length
                ? nodes
                : blocks.map((code) => {
                    const box = document.createElement("div");
                    box.className = "mermaid not-prose my-8 flex justify-center overflow-x-auto rounded-2xl border border-line bg-surface p-6";
                    box.dataset.source = code.textContent ?? "";
                    code.parentElement!.replaceWith(box);
                    return box;
                  });
              mermaid.initialize({ startOnLoad: false, theme: dark() ? "dark" : "neutral", fontFamily: "Inter Variable, sans-serif" });
              for (const box of nodes) {
                box.removeAttribute("data-processed");
                box.textContent = box.dataset.source ?? "";
              }
              await mermaid.run({ nodes });
            });
          await draw();
          addEventListener("themechange", draw);
        },
        { rootMargin: "800px" },
      );
      blocks.forEach((code) => near.observe(code.parentElement!));
    }
  </script>
</Layout>
