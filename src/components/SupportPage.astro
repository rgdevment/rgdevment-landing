---
import Crumbs from "./Crumbs.astro";
import Icon from "./Icon.astro";
import Layout from "../layouts/Layout.astro";
import { PRODUCTS, storeUrl } from "../content/products";
import { crumbs, type Locale } from "../site";
import ProductIcon from "./ProductIcon.astro";

interface Props {
  locale: Locale;
  only?: string;
}

const { locale, only } = Astro.props;
const shown = only ? PRODUCTS.filter((one) => one.slug === only) : PRODUCTS;
const es = locale === "es";
const paths = { en: "support", es: "colaborar" };

const SPONSOR = "https://github.com/sponsors/rgdevment";
const COFFEE = "https://buymeacoffee.com/rgdevment";

const say = es
  ? {
      title: "Cómo colaborar",
      seo: "Cómo colaborar con software libre, gratis y sin telemetría",
      description:
        "Formas de ayudar a que estas herramientas sigan existiendo. La mayoría no cuesta dinero, y son las que más sirven.",
      lede: "Sin telemetría no sé cuánta gente usa esto, y sin publicidad nadie lo encuentra por su cuenta. Así que lo que más ayuda no es el dinero: es que alguien diga que existe.",
      freeTitle: "Lo que más ayuda, y es gratis",
      free: [
        ["Una estrella en GitHub", "Es la señal que miran las listas, los agregadores y quien duda si un proyecto está vivo. Cuesta un clic."],
        ["Una valoración en la Microsoft Store", "Decide si alguien que busca «browser picker» llega a encontrarlo. Diez valoraciones cambian por completo dónde aparece."],
        ["Contarlo donde se pregunte", "La mayoría de quien llega aquí lo hace porque alguien lo mencionó en un hilo. Vale más que cualquier anuncio."],
        ["Reportar lo que falla", "Un navegador que no detecta, una regla que no aplica, una palabra mal traducida. Se arregla lo que alguien cuenta."],
      ],
      moneyTitle: "Si prefieres poner dinero",
      money: "No hace falta y no desbloquea nada: no hay versión de pago que comprar. Sirve para cubrir lo que esto cuesta de verdad — la cuenta de desarrollador de Apple, la de Microsoft, los dominios — y para que siga habiendo ratos dedicados a ello.",
      sponsor: "Patrocinar en GitHub",
      sponsorNote: "Mensual o puntual",
      coffee: "Invitar a un café",
      coffeeNote: "Pago único",
      codeTitle: "Si escribes código",
      code: "Todas son de código abierto y las aportaciones se revisan. Lo más útil no suele ser una función nueva: es una traducción, un navegador que nadie había probado, o un caso que rompe algo.",
      repos: "Los repositorios",
      home: "Inicio",
    }
  : {
      title: "How to support",
      seo: "How to support free, open source apps with no telemetry",
      description:
        "Ways to help these tools keep existing. Most of them cost nothing, and those are the ones that help most.",
      lede: "With no telemetry I do not know how many people use these, and with no advertising nobody finds them on their own. So what helps most is not money: it is somebody saying they exist.",
      freeTitle: "What helps most, and is free",
      free: [
        ["A star on GitHub", "It is the signal that lists, aggregators and anyone wondering whether a project is alive all look at. One click."],
        ["A rating on the Microsoft Store", "It decides whether somebody searching for a browser picker ever finds it. Ten ratings change where you appear entirely."],
        ["Mentioning it where people ask", "Most people who land here do so because somebody named it in a thread. That beats any advertising."],
        ["Reporting what breaks", "A browser it fails to detect, a rule that does not apply, a badly translated word. What gets told is what gets fixed."],
      ],
      moneyTitle: "If you would rather give money",
      money: "You do not need to, and it unlocks nothing: there is no paid tier to buy. It covers what this actually costs — the Apple developer account, the Microsoft one, the domains — and keeps hours going into it.",
      sponsor: "Sponsor on GitHub",
      sponsorNote: "Monthly or one-off",
      coffee: "Buy me a coffee",
      coffeeNote: "One-off",
      codeTitle: "If you write code",
      code: "They are all open source and contributions get reviewed. The most useful thing is rarely a new feature: it is a translation, a browser nobody had tried, or a case that breaks something.",
      repos: "The repositories",
      home: "Home",
    };

const schema = crumbs(locale, [[say.title, paths[locale]]]);
const icons = ["star", "store", "heart", "code"] as const;
---

<Layout
  title={say.seo}
  description={say.description}
  locale={locale}
  path={paths[locale]}
  paths={paths}
  here="support"
  schema={schema}
>
  <section class="relative isolate overflow-hidden">
    <div class="dotgrid absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="shell pt-10 sm:pt-14">
      <Crumbs locale={locale} trail={[[say.title, paths[locale]]]} />
      <header class="mt-12 max-w-3xl">
        <span class="grid h-14 w-14 place-items-center rounded-2xl bg-flame-tint text-flame-ink">
          <Icon name="heart" class="h-7 w-7" />
        </span>
        <h1 class="mt-6 text-5xl font-semibold tracking-[-0.03em] sm:text-6xl">{say.title}</h1>
        <p class="mt-6 text-lg text-body sm:text-xl">{say.lede}</p>
      </header>
    </div>
  </section>

  <section class="shell mt-16">
    <h2 class="section-title">{say.freeTitle}</h2>
    <dl class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        say.free.map(([term, body], at) => (
          <div class="card p-6">
            <dt class="flex items-center gap-3 font-display text-lg font-semibold text-fg">
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-sunken text-fg">
                <Icon name={icons[at]} class="h-5 w-5" />
              </span>
              {term}
            </dt>
            <dd class="mt-3 text-body">{body}</dd>
          </div>
        ))
      }
    </dl>

    <ul class="mt-6 grid gap-3 sm:grid-cols-3">
      {
        shown.map((product) => {
          const store = storeUrl(product);
          return (
            <li class="card flex items-center gap-3 p-4">
              <ProductIcon product={product} size={36} class="h-9 w-9 rounded-xl" loading="lazy" />
              <span class="flex-1 font-medium text-fg">{product.name}</span>
              <a class="grid h-9 w-9 place-items-center rounded-full border border-line text-muted transition hover:border-fg/25 hover:text-fg" href={product.repo} rel="noopener" aria-label={`${product.name} · GitHub`} title="GitHub">
                <Icon name="star" class="h-4 w-4" />
              </a>
              {store && (
                <a class="grid h-9 w-9 place-items-center rounded-full border border-line text-muted transition hover:border-fg/25 hover:text-fg" href={store} rel="noopener" aria-label={`${product.name} · Microsoft Store`} title="Microsoft Store">
                  <Icon name="windows" class="h-4 w-4" />
                </a>
              )}
            </li>
          );
        })
      }
    </ul>
  </section>

  <section class="shell mt-24 sm:mt-32">
    <div class="grid gap-10 rounded-[2rem] bg-night px-7 py-12 text-stone-400 sm:px-12 lg:grid-cols-[1.2fr_1fr] lg:items-center">
      <div>
        <h2 class="text-3xl font-semibold tracking-tight text-white sm:text-4xl">{say.moneyTitle}</h2>
        <p class="mt-4 text-lg">{say.money}</p>
      </div>
      <div class="grid gap-3">
        <a class="group flex items-center gap-4 rounded-2xl border border-night-line bg-night-soft px-5 py-4 transition hover:border-stone-600" href={SPONSOR} rel="noopener">
          <Icon name="github" class="h-6 w-6 text-white" />
          <span class="flex-1">
            <span class="block font-medium text-white">{say.sponsor}</span>
            <span class="block text-sm text-stone-400">{say.sponsorNote}</span>
          </span>
          <Icon name="arrow" class="h-4 w-4 text-stone-400 transition group-hover:translate-x-0.5 group-hover:text-white" />
        </a>
        <a class="group flex items-center gap-4 rounded-2xl border border-night-line bg-night-soft px-5 py-4 transition hover:border-stone-600" href={COFFEE} rel="noopener">
          <Icon name="heart" class="h-6 w-6 text-flame" />
          <span class="flex-1">
            <span class="block font-medium text-white">{say.coffee}</span>
            <span class="block text-sm text-stone-400">{say.coffeeNote}</span>
          </span>
          <Icon name="arrow" class="h-4 w-4 text-stone-400 transition group-hover:translate-x-0.5 group-hover:text-white" />
        </a>
      </div>
    </div>
  </section>

  <section class="shell mt-20">
    <div class="mx-auto max-w-3xl">
      <h2 class="section-title">{say.codeTitle}</h2>
      <p class="mt-4 text-lg text-body">{say.code}</p>
      <ul class="mt-6 flex flex-wrap gap-2">
        {
          shown.map((one) => (
            <li>
              <a class="chip transition hover:border-fg/25" href={one.repo} rel="noopener">
                <Icon name="github" class="h-3.5 w-3.5" />
                rgdevment/{one.repo.split("/").pop()}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>
