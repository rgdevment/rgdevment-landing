---
import Icon from "./Icon.astro";
import { docPath } from "../content/docs";
import type { Assistant, Product } from "../content/products";
import { href, type Locale } from "../site";

interface Props {
  product: Product;
  words: Assistant;
  locale: Locale;
}

const { product, words, locale } = Astro.props;
const mcp = product.mcp!;
const copy = locale === "es" ? { label: "Copiar", done: "Copiado" } : { label: "Copy", done: "Copied" };
---

<section class="shell mt-24 sm:mt-32">
  <h2 class="section-title">{words.title}</h2>
  <p class="mt-3 text-muted">{words.lede}</p>

  <div class="mt-10 grid grid-cols-1 gap-4 lg:grid-cols-[1.15fr_1fr]">
    <div class="card min-w-0 p-6 sm:p-7">
      <ul class="space-y-4">
        {
          mcp.connect.map(({ who, command }) => (
            <li>
              <span class="block text-sm font-medium text-fg">{who ?? words.other}</span>
              <div class="mt-2 flex items-center gap-2 rounded-2xl bg-night py-2.5 pr-2 pl-4">
                <code class="flex-1 overflow-x-auto whitespace-nowrap font-mono text-[13px] text-stone-100">{command}</code>
                <button
                  type="button"
                  class="copy shrink-0 rounded-lg p-1.5 text-stone-400 transition hover:bg-night-soft hover:text-white"
                  data-copy={command}
                  aria-label={copy.label}
                  data-done={copy.done}
                >
                  <Icon name="copy" class="h-4 w-4" />
                </button>
              </div>
            </li>
          ))
        }
      </ul>
      <p class="mt-5 text-sm text-body">{words.settings}</p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
      <div class="card p-6">
        <h3 class="text-lg font-semibold text-fg">{words.can.title}</h3>
        <ul class="mt-3 space-y-2 text-sm text-body">
          {
            words.can.items.map((one) => (
              <li class="flex gap-2">
                <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full" style={`background: ${product.accent}`} aria-hidden="true" />
                {one}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="card p-6">
        <h3 class="text-lg font-semibold text-fg">{words.never.title}</h3>
        <ul class="mt-3 space-y-2 text-sm text-body">
          {
            words.never.items.map((one) => (
              <li class="flex gap-2">
                <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-muted" aria-hidden="true" />
                {one}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <div class="mt-4 flex flex-col gap-4 rounded-3xl border border-flame/25 bg-flame-tint p-6 sm:flex-row sm:items-center sm:p-7">
    <span class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-surface text-flame-ink">
      <Icon name="lock" class="h-5 w-5" />
    </span>
    <p class="text-body">{words.door}</p>
  </div>

  <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm">
    <span class="text-muted">{words.listed}</span>
    <span class="chip">MCP Registry · {mcp.registry}</span>
    {
      (product.listings ?? []).map(([name, url]) => (
        <a class="chip transition hover:border-fg/25 hover:text-fg" href={url} rel="noopener">{name}</a>
      ))
    }
  </div>

  <a class="mt-6 inline-flex items-center gap-1.5 font-medium text-fg hover:underline" href={href(locale, docPath(locale, product.slug, words.page))}>
    {words.more}
    <Icon name="arrow" class="h-4 w-4" />
  </a>
</section>
