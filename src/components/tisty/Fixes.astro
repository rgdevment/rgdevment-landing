---
import type { Fixes, Product } from "../../content/products";
import { inkOf } from "../../content/products";
import type { Topic } from "../../content/topics";

interface Props {
  product: Product;
  fixes: Fixes;
  on: Topic;
}

const { product, fixes, on } = Astro.props;
const ink = inkOf(product);
const rows = fixes.rows.filter((one) => one.on === on);
---

<section class="stage shell mt-24 sm:mt-32">
  <h2 class="section-title">{fixes.title}</h2>
  <div class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-2">
    {
      rows.map((one) => (
        <div class="card p-6 sm:p-7">
          <p class="accent-ink text-xs font-medium uppercase tracking-[0.12em]" style={ink}>{one.who}</p>
          <p class="eyebrow mt-4">{fixes.said.problem}</p>
          <h3 class="mt-1.5 text-lg font-semibold">{one.problem}</h3>
          <div class="mt-5 border-l-2 pl-4" style={`border-color: ${product.accent}`}>
            <p class="accent-ink text-xs font-medium uppercase tracking-[0.12em]" style={ink}>{fixes.said.fix}</p>
            <p class="mt-1.5 text-body">{one.fix}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>
