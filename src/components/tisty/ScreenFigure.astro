---
import Shade from "../Shade.astro";
import type { Screen } from "../../content/products";

interface Props {
  screen: Screen;
  sizes?: string;
  caption?: boolean;
}

const { screen, sizes, caption = true } = Astro.props;
---

<figure class="min-w-0">
  <Shade screen={screen} sizes={sizes} />
  {
    caption && (
      <figcaption class="mt-4 px-1">
        <span class="block text-lg font-semibold text-fg">{screen.title}</span>
        <span class="mt-1 block text-body">{screen.text}</span>
      </figcaption>
    )
  }
</figure>
