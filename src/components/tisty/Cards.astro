---
import Icon from "../Icon.astro";
import { docPath } from "../../content/docs";
import { type Product, inkOf } from "../../content/products";
import type { Card } from "../../content/tisty-pages";
import { href, type Locale } from "../../site";

interface Props {
  product: Product;
  locale: Locale;
  title: string;
  lede?: string;
  cards: Card[];
}

const { product, locale, title, lede, cards } = Astro.props;
const ink = inkOf(product);
const more = locale === "es" ? "En la ayuda" : "In the docs";
const linkOf = (one: Card) => one.page && `${href(locale, docPath(locale, product.slug, one.page))}${one.anchor ? `#${one.anchor}` : ""}`;
---

<section class="stage shell mt-24 sm:mt-32">
  <h2 class="section-title">{title}</h2>
  {lede && <p class="mt-3 max-w-3xl text-muted">{lede}</p>}
  <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      cards.map((one) => (
        <div class="card flex flex-col p-6">
          <h3 class="accent-ink text-lg font-semibold" style={ink}>{one.title}</h3>
          <p class="mt-2 text-body">{one.body}</p>
          {linkOf(one) && (
            <a class="mt-auto inline-flex items-center gap-1 pt-4 text-sm font-medium text-fg hover:underline" href={linkOf(one)}>
              {more}
              <Icon name="arrow" class="h-3.5 w-3.5" />
            </a>
          )}
        </div>
      ))
    }
  </div>
  <slot />
</section>
