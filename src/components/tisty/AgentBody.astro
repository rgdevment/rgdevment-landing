---
import Cards from "./Cards.astro";
import Fixes from "./Fixes.astro";
import ScreenFigure from "./ScreenFigure.astro";
import Assistant from "../Assistant.astro";
import Shade from "../Shade.astro";
import { type Product, inkOf, words } from "../../content/products";
import { AGENT_PAGE } from "../../content/tisty-pages";
import { screensOf } from "../../content/tisty";
import type { Locale } from "../../site";

interface Props {
  product: Product;
  locale: Locale;
}

const { product, locale } = Astro.props;
const t = words(product, locale);
const say = AGENT_PAGE[locale];
const ink = inkOf(product);
const day = t.day!;
const cost = t.cost!;
const [archive, agents] = screensOf(t.screens!, ["archive", "agents"]);
const dot = `background: ${product.accent}`;
---

<section class="shell mt-16 sm:mt-24">
  <h2 class="section-title">{say.roles.title}</h2>
  <p class="mt-3 max-w-3xl text-muted">{say.roles.lede}</p>
  <div class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-2">
    {
      [say.roles.you, say.roles.agent].map((side) => (
        <div class="card p-6 sm:p-8">
          <h3 class="accent-ink text-xl font-semibold" style={ink}>{side.title}</h3>
          <ul class="mt-4 space-y-3">
            {side.items.map((one) => (
              <li class="flex gap-2.5 text-body">
                <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full" style={dot} aria-hidden="true" />
                <span>{one}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<Cards product={product} locale={locale} title={say.trust.title} cards={say.trust.cards} />

<section class="stage shell mt-24 sm:mt-32">
  <h2 class="section-title">{day.title}</h2>
  <p class="mt-3 text-muted">{day.lede}</p>
  <ol class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      day.steps.map((one, at) => (
        <li class="card p-6">
          <span class="accent-ink text-sm font-medium" style={ink}>
            {String(at + 1).padStart(2, "0")}
          </span>
          <h3 class="mt-3 text-lg font-semibold">{one.title}</h3>
          <p class="mt-1.5 text-body">{one.body}</p>
        </li>
      ))
    }
  </ol>
  <p class="mt-8 text-xl leading-snug text-fg">{day.close}</p>
  <div class="mx-auto mt-12 max-w-4xl">
    <ScreenFigure screen={archive} />
  </div>
</section>

<section class="stage shell mt-24 sm:mt-32">
  <div class="relative isolate overflow-hidden rounded-[2rem] border border-line p-6 sm:p-10 lg:p-12" style={`--accent: ${product.accent}`}>
    <div
      class="pointer-events-none absolute -top-40 left-1/2 -z-10 h-[28rem] w-[52rem] -translate-x-1/2 rounded-full opacity-[0.16] blur-3xl"
      style="background: radial-gradient(closest-side, var(--accent), transparent)"
      aria-hidden="true"
    ></div>
    <h2 class="section-title">{cost.title}</h2>
    <p class="mt-3 text-lg text-body">{cost.lede}</p>
    <ul class="mt-10 grid gap-4 md:grid-cols-2">
      {
        cost.rows.map((one) => (
          <li class="card flex flex-col p-6 sm:p-7">
            <p class="accent-ink text-5xl font-semibold tracking-[-0.03em] sm:text-6xl" style={ink}>{one.saving}</p>
            <p class="eyebrow mt-1">{cost.less}</p>
            <p class="mt-5 font-medium text-fg">{one.what}</p>
            <p class="mt-1 text-sm text-muted">{one.spends}</p>
          </li>
        ))
      }
    </ul>
    <h3 class="mt-10 text-xl font-semibold">{cost.whyTitle}</h3>
    <ul class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
      {
        cost.why.map((one) => (
          <li class="flex gap-2.5 text-body">
            <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full" style={dot} aria-hidden="true" />
            <span>{one}</span>
          </li>
        ))
      }
    </ul>
    <p class="mt-6 text-sm text-muted">{cost.caveat}</p>
  </div>
</section>

<Fixes product={product} fixes={t.fixes!} on="agent" />

<section class="stage shell mt-24 sm:mt-32">
  <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-[2fr_3fr]">
    <div>
      <h2 class="section-title">{agents.title}</h2>
      <p class="mt-4 text-body">{agents.text}</p>
    </div>
    <Shade screen={agents} sizes="(min-width: 1024px) 600px, calc(100vw - 2.5rem)" />
  </div>
</section>

<Assistant product={product} words={t.assistant!} locale={locale}>
  <p class="mt-6 text-sm text-muted">{say.works}</p>
</Assistant>
