---
import Copy from "../Copy.astro";
import Download from "../Download.astro";
import Faq from "../Faq.astro";
import Film from "../Film.astro";
import Icon from "../Icon.astro";
import Install from "../Install.astro";
import Screens from "../Screens.astro";
import Shade from "../Shade.astro";
import WritingMark from "../WritingMark.astro";
import Layout from "../../layouts/Layout.astro";
import { changelogUrl } from "../../content/changelog";
import { COMPARE_PATH, comparisonOf } from "../../content/compare";
import { docPath } from "../../content/docs";
import { GUIDES, written } from "../../content/guides";
import { NEWS_PATH, hasNews } from "../../content/news";
import { privacyPath } from "../../content/privacy";
import { type Product, cardOf, inkOf, words } from "../../content/products";
import { latestRelease, releaseDate } from "../../content/releases";
import { appSchema, faqSchema, screenshotsOf } from "../../content/schema";
import { HOME, type Door } from "../../content/tisty-pages";
import { screensOf } from "../../content/tisty";
import { TOPIC_PATH } from "../../content/topics";
import { canonical, href, type Locale } from "../../site";

interface Props {
  product: Product;
  locale: Locale;
}

const { product, locale } = Astro.props;
const t = words(product, locale);
const say = HOME[locale];
const es = locale === "es";
const ink = inkOf(product);
const release = await latestRelease(product);
const [hero] = screensOf(t.screens!, ["brainsty"]);
const best = screensOf(t.screens!, ["documents", "task", "week", "diary", "agents"]);
const questions = t.faq.filter((one) => one.on === "home");
const compared = comparisonOf(product.slug);
const told = await hasNews(product.slug);
const guides = GUIDES.filter((one) => one.product === product.slug).map((one) => written(one, locale));
const docs = href(locale, docPath(locale, product.slug));
const faqPage = href(locale, docPath(locale, product.slug, es ? "preguntas-frecuentes" : "faq"));

const doors: [Door, string][] = [
  [say.doors.agent, href(locale, TOPIC_PATH.agent[locale])],
  [say.doors.alone, href(locale, TOPIC_PATH.alone[locale])],
];
const keeps = ["disk", "lock", "eye", "shield", "licence"] as const;

const schema = [
  appSchema(product, locale, release, canonical(locale, docPath(locale, product.slug)), screenshotsOf([hero, ...best], locale)),
  faqSchema(questions),
];
const more = "inline-flex items-center gap-1.5 font-medium text-fg hover:underline";
---

<Layout
  title={t.title!}
  description={t.meta}
  image={cardOf(product, locale)}
  imageAlt={product.shot![locale]}
  locale={locale}
  path={product.slug}
  here={product.slug}
  schema={schema}
>
  <section class="relative isolate overflow-hidden" style={`--accent: ${product.accent}`}>
    <div
      class="pointer-events-none absolute -top-40 left-1/2 -z-10 h-[34rem] w-[60rem] -translate-x-1/2 rounded-full opacity-[0.16] blur-3xl"
      style="background: radial-gradient(closest-side, var(--accent), transparent)"
      aria-hidden="true"
    ></div>
    <div class="dotgrid absolute inset-0 -z-10" aria-hidden="true"></div>

    <div class="shell grid items-center gap-6 pt-8 sm:gap-10 sm:pt-14 lg:grid-cols-[6fr_5fr] lg:pt-16">
      <header class="mx-auto max-w-3xl text-center lg:mx-0 lg:text-left">
        <WritingMark class="mx-auto h-12 w-12 sm:h-20 sm:w-20 lg:mx-0" />
        <h1 class="mt-4 text-5xl font-semibold tracking-[-0.03em] sm:text-6xl">
          {product.name}<span class="sr-only">: </span>
          <span class="mt-3 block text-base font-medium tracking-normal text-muted sm:text-lg">{t.category}</span>
        </h1>
        <p class="mt-5 text-2xl font-medium leading-snug text-fg sm:text-3xl lg:text-[2rem]">{t.tagline}</p>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-body lg:mx-0">{t.hybrid}</p>
        <Download product={product} locale={locale} release={release} docs={docs} start compact />
      </header>

      <div class="relative mx-auto w-full max-w-5xl">
        <div class="hero-halo absolute inset-x-6 inset-y-4 -z-10 rounded-[40%]" aria-hidden="true"></div>
        <Shade screen={hero} sizes="(min-width: 1024px) 46vw, (min-width: 640px) calc(100vw - 4rem), calc(100vw - 2.5rem)" priority class="px-1 sm:px-4 lg:px-0" />
      </div>
    </div>
  </section>

  <Film film={t.film!} />

  <section class="stage shell mt-24 sm:mt-32">
    <h2 class="section-title">{say.doors.title}</h2>
    <p class="mt-3 max-w-3xl text-muted">{say.doors.lede}</p>
    <div class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-2">
      {
        doors.map(([door, to]) => (
          <div class="card flex flex-col p-6 sm:p-8">
            <h3 class="accent-ink text-2xl font-semibold" style={ink}>{door.title}</h3>
            <p class="mt-2 text-lg text-fg">{door.line}</p>
            <ul class="mt-5 space-y-3">
              {door.points.map((one) => (
                <li class="flex gap-2.5 text-body">
                  <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full" style={`background: ${product.accent}`} aria-hidden="true" />
                  <span>{one}</span>
                </li>
              ))}
            </ul>
            <a class:list={[more, "mt-auto pt-6"]} href={to}>
              {door.link}
              <Icon name="arrow" class="h-4 w-4" />
            </a>
          </div>
        ))
      }
    </div>
  </section>

  <section class="shell mt-24 sm:mt-32">
    <h2 class="section-title text-center">{say.best}</h2>
    <Screens name={product.name} screens={best} locale={locale} />
  </section>

  <section class="stage shell mt-24 sm:mt-32">
    <div class="rounded-3xl border border-flame/25 bg-flame-tint p-7 sm:p-10">
      <h2 class="section-title">{say.data.title}</h2>
      <p class="mt-3 text-lg text-body">{say.data.lede}</p>
      <ul class="mt-6 flex flex-wrap gap-2">
        {
          say.data.points.map((one, at) => (
            <li class="chip">
              <Icon name={keeps[at]} class="h-3.5 w-3.5" />
              {one}
            </li>
          ))
        }
      </ul>
      <p class="mt-6 max-w-3xl text-body">{say.data.free}</p>
      <p class="mt-5 flex flex-wrap gap-x-6 gap-y-2">
        <a class={more} href={href(locale, TOPIC_PATH.data[locale])}>
          {say.data.link}
          <Icon name="arrow" class="h-4 w-4" />
        </a>
        <a class="inline-flex items-center gap-1.5 text-sm font-medium text-flame-ink hover:underline" href={href(locale, privacyPath(locale, product.slug))}>
          {say.data.policy}
        </a>
      </p>
    </div>
  </section>

  <Install product={product} locale={locale}>
    {
      release && (
        <p class="mt-6 text-sm text-muted">
          <a class="chip text-xs transition hover:border-fg/25" href={changelogUrl(product, locale, release.version)}>
            <span class="h-1.5 w-1.5 rounded-full bg-flame" aria-hidden="true" />
            v{release.version} · {releaseDate(release, locale)}
          </a>
        </p>
      )
    }
  </Install>

  <Faq locale={locale} questions={questions} class="stage">
    <a class:list={[more, "mt-6"]} href={faqPage}>
      {say.faqMore}
      <Icon name="arrow" class="h-4 w-4" />
    </a>
  </Faq>

  <section class="shell mt-24 sm:mt-32">
    <div class="border-t border-line pt-10">
      <h2 class="eyebrow">{say.more.title}</h2>
      <div class="mt-6 grid grid-cols-1 gap-8 sm:grid-cols-2">
        <ul class="space-y-3">
          {
            compared && (
              <li>
                <a class={more} href={href(locale, COMPARE_PATH[locale])}>{say.more.compare}<Icon name="arrow" class="h-4 w-4" /></a>
              </li>
            )
          }
          {
            told && (
              <li>
                <a class={more} href={href(locale, NEWS_PATH[locale])}>{say.more.news}<Icon name="arrow" class="h-4 w-4" /></a>
              </li>
            )
          }
          <li>
            <a class={more} href={docs}>{say.more.docs}<Icon name="arrow" class="h-4 w-4" /></a>
          </li>
        </ul>
        <div>
          <h3 class="text-sm font-medium text-muted">{say.more.guides}</h3>
          <ul class="mt-3 space-y-2">
            {
              guides.map((one) => (
                <li>
                  <a class="text-body transition-colors hover:text-fg" href={href(locale, one.slug)}>{one.title}</a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <Copy />
</Layout>

<style>
  .hero-halo {
    background: rgb(228 181 89 / 0.35);
    filter: blur(40px);
  }

  :global(:root[data-theme="dark"]) .hero-halo {
    background: rgb(228 181 89 / 0.1);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .hero-halo {
      background: rgb(228 181 89 / 0.1);
    }
  }
</style>
