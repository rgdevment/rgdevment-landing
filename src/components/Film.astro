---
import sharp from "sharp";
import type { Film } from "../content/products";
import { versioned } from "../versioned";

interface Props {
  film: Film;
}

const { film } = Astro.props;
const poster = `${film.video}-poster.webp`;
const { width, height } = await sharp(`./public${poster}`).metadata();
---

<section class="shell mt-24 sm:mt-32">
  <h2 class="section-title">{film.title}</h2>
  <p class="mt-3 max-w-3xl text-muted">{film.lede}</p>
  <div class="relative mx-auto mt-10 max-w-5xl" data-film data-play={film.play} data-pause={film.pause}>
    <video
      class="block h-auto w-full rounded-md border border-white/10 bg-night shadow-[0_24px_50px_-24px_rgb(40_25_5/0.55)] sm:rounded-lg"
      width={width}
      height={height}
      poster={versioned(poster)}
      aria-label={film.label}
      muted
      loop
      playsinline
      controls
      preload="none"
    >
      <source src={versioned(`${film.video}.webm`)} type='video/webm; codecs="av01.0.05M.10"' />
      <source src={versioned(`${film.video}.mp4`)} type='video/mp4; codecs="avc1.640032"' />
    </video>
    <button
      type="button"
      class="absolute bottom-3 right-3 hidden h-9 w-9 place-items-center rounded-full bg-black/55 text-white backdrop-blur transition hover:bg-black/75"
      aria-label={film.play}
      data-film-turn
    >
      <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true" data-film-playing>
        <rect x="6.5" y="5" width="3.5" height="14" rx="1" />
        <rect x="14" y="5" width="3.5" height="14" rx="1" />
      </svg>
      <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true" data-film-stopped>
        <path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z" />
      </svg>
    </button>
  </div>
</section>

<script>
  const still = matchMedia("(prefers-reduced-motion: reduce)");

  for (const box of document.querySelectorAll<HTMLElement>("[data-film]")) {
    const video = box.querySelector("video")!;
    const turn = box.querySelector<HTMLButtonElement>("[data-film-turn]")!;
    let wanted = !still.matches;
    let seen = false;

    const draw = () => {
      const playing = !video.paused;
      turn.setAttribute("aria-label", (playing ? box.dataset.pause : box.dataset.play)!);
      turn.querySelector("[data-film-playing]")!.classList.toggle("hidden", !playing);
      turn.querySelector("[data-film-stopped]")!.classList.toggle("hidden", playing);
    };

    const follow = () => {
      if (wanted && seen) video.play().catch(() => {});
      else video.pause();
    };

    video.controls = false;
    turn.classList.replace("hidden", "grid");
    video.addEventListener("play", draw);
    video.addEventListener("pause", draw);
    turn.addEventListener("click", () => {
      wanted = video.paused;
      if (wanted) video.play().catch(() => {});
      else video.pause();
    });
    still.addEventListener("change", () => {
      wanted = !still.matches;
      follow();
    });
    new IntersectionObserver(
      ([entry]) => {
        seen = entry.isIntersecting;
        follow();
      },
      { threshold: 0.4 },
    ).observe(video);
    draw();
  }
</script>
