---
import AlternativeTo from "./AlternativeTo.astro";
import Crumbs from "./Crumbs.astro";
import Icon from "./Icon.astro";
import Verdict from "./Verdict.astro";
import Layout from "../layouts/Layout.astro";
import { COMPARE_PATH, comparisonOf, tally } from "../content/compare";
import { PRODUCTS, inkOf } from "../content/products";
import { HOME_PRODUCT, appRef, canonical, crumbs, href, type Locale } from "../site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const compared = comparisonOf(HOME_PRODUCT)!;
const t = compared[locale];
const path = COMPARE_PATH[locale];
const product = PRODUCTS.find((one) => one.slug === HOME_PRODUCT)!;
const trail: [string, string][] = [[product.name, ""], [t.short, path]];
const ink = inkOf(product);
const only = tally(t);
const tint = "bg-[color-mix(in_srgb,var(--accent)_10%,transparent)]";
const [, ...others] = compared.rivals;
const priced = (own?: string) => (own ? href(locale, own) : undefined);
---

<Layout
  title={t.title}
  description={t.meta}
  locale={locale}
  paths={COMPARE_PATH}
  schema={[
    crumbs(locale, trail),
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      url: canonical(locale, path),
      name: t.title,
      description: t.meta,
      about: appRef(product),
      mentions: others.map((one) => ({ "@type": "SoftwareApplication", name: one.name, url: one.url })),
    },
    ...(t.faq
      ? [
          {
            "@context": "https://schema.org",
            "@type": "FAQPage",
            mainEntity: t.faq.items.map((one) => ({ "@type": "Question", name: one.q, acceptedAnswer: { "@type": "Answer", text: one.a } })),
          },
        ]
      : []),
  ]}
>
  <section class="shell pt-10 sm:pt-14" style={`--accent: ${product.accent}`}>
    <Crumbs locale={locale} trail={trail} />
    <header class="mt-10">
      <p class="eyebrow">{t.short}</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-[-0.03em] sm:text-5xl">{t.heading}</h1>
      <p class="mt-5 text-lg text-body">{t.lede}</p>
      <p class="mt-6 inline-flex items-center gap-2 rounded-full border border-line px-4 py-1.5 text-base font-semibold text-fg" style="border-color: color-mix(in srgb, var(--accent) 45%, transparent)">
        <Icon name="star" class="h-4 w-4" />
        {only}
      </p>
      <p class="mt-4 text-sm text-muted">{t.checked}</p>
    </header>

    <div role="region" class="mt-10 md:overflow-x-auto md:rounded-3xl md:border md:border-line md:bg-surface" tabindex="0" aria-label={t.heading}>
      <table class="compare-table w-full border-collapse text-left text-sm" role="table">
        <caption class="sr-only">{t.heading}</caption>
        <thead class="sr-only md:not-sr-only" role="rowgroup">
          <tr class="border-b border-line" role="row">
            <td class="sticky left-0 z-10 min-w-[11rem] bg-surface p-4" role="cell"></td>
            {
              compared.rivals.map((one, at) => (
                <th scope="col" role="columnheader" class:list={["min-w-[9.5rem] p-4 text-base font-semibold text-fg", { [tint]: at === 0 }]}>
                  {one.name}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody role="rowgroup">
          {
            t.rows.map((row) => (
              <tr class="compare-row md:border-b md:border-line md:last:border-0" role="row">
                <th scope="row" role="rowheader" class="compare-rowhead font-medium text-fg md:sticky md:left-0 md:z-10 md:min-w-[11rem] md:bg-surface md:p-4 md:align-top">
                  {row.label}
                </th>
                {row.cells.map((cell, at) => (
                  <td
                    role="cell"
                    data-label={compared.rivals[at].name}
                    class:list={["compare-cell break-words md:min-w-[9.5rem] md:p-4 md:align-top", { [tint]: at === 0, "compare-own": at === 0 }]}
                  >
                    <div class="min-w-0">
                      <Verdict cell={cell} label={t.marks[cell.mark]} ink={at === 0 ? ink : undefined} to={at === 0 ? priced(row.own) : undefined} />
                      {cell.note && <span class="mt-1 block text-[13px] leading-snug text-muted">{cell.note}</span>}
                    </div>
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    {
      product.signals?.alternativeto && (
        <div class="mt-8">
          <AlternativeTo url={product.signals.alternativeto} name={product.name} locale={locale} />
        </div>
      )
    }
  </section>

  {
    t.agent && (
      <section class="shell mt-20" style={`--accent: ${product.accent}`}>
        <h2 class="section-title">{t.agent.title}</h2>
        <div class="mt-4 space-y-4 text-lg text-body">
          {t.agent.body.map((one) => <p>{one}</p>)}
        </div>
        <a class="mt-6 inline-flex items-center gap-1.5 font-medium text-fg hover:underline" href={t.agent.link.url}>
          {t.agent.link.label}
          <Icon name="arrow" class="h-4 w-4" />
        </a>
      </section>
    )
  }

  {
    t.faq && (
      <section class="shell mt-20">
        <h2 class="section-title">{t.faq.title}</h2>
        <dl class="mt-8 grid gap-4 md:grid-cols-2">
          {t.faq.items.map((one) => (
            <div class="card p-6">
              <dt class="text-lg font-semibold text-fg">{one.q}</dt>
              <dd class="mt-2 text-body">{one.a}</dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  <section class="shell mt-20">
    <h2 class="section-title">{t.stronger.title}</h2>
    <p class="mt-3 text-muted">{t.stronger.lede}</p>
    {
      t.stronger.groups.map((group) => {
        const ItemHeading = group.title ? "h4" : "h3";
        return (
        <div class="mt-10">
          {group.title && <h3 class="text-xl font-semibold text-fg">{group.title}</h3>}
          <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {group.items.map((one) => (
              <li class="card flex flex-col p-6">
                <ItemHeading class="text-lg font-semibold text-fg">{one.name}</ItemHeading>
                {one.facts && (
                  <ul class="mt-3 flex flex-wrap gap-1.5">
                    {one.facts.map((fact) => (
                      <li class="chip text-xs">{fact}</li>
                    ))}
                  </ul>
                )}
                {group.label && <p class="eyebrow mt-4">{group.label}</p>}
                <p class={group.label ? "mt-1.5 text-body" : "mt-2 text-body"}>{one.text}</p>
              </li>
            ))}
          </ul>
        </div>
        );
      })
    }
    <a class="btn-primary mt-10" href={`${href(locale)}#download`}>
      <Icon name="download" class="h-4 w-4" />
      {t.back}
    </a>
  </section>

  <section class="shell mt-20">
    <h2 class="eyebrow">{t.sources}</h2>
    <div class="mt-4 grid gap-6 text-sm sm:grid-cols-2 lg:grid-cols-3">
      {
        compared.sources.map(([name, urls]) => (
          <div>
            <h3 class="font-medium text-fg">{name}</h3>
            <ul class="mt-2 space-y-1">
              {urls.map((url) => (
                <li class="break-all">
                  <a class="text-muted underline decoration-muted underline-offset-4 hover:text-fg" href={url} rel="noopener">
                    {url.replace(/^https:\/\/(www\.)?/, "")}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</Layout>
