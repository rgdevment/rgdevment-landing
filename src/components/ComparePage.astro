---
import Crumbs from "./Crumbs.astro";
import Icon from "./Icon.astro";
import Verdict from "./Verdict.astro";
import Layout from "../layouts/Layout.astro";
import { COMPARE_PATH, comparisonOf, tally } from "../content/compare";
import { PRODUCTS, inkOf } from "../content/products";
import { HOME_PRODUCT, appId, canonical, crumbs, href, type Locale } from "../site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const compared = comparisonOf(HOME_PRODUCT)!;
const t = compared[locale];
const path = COMPARE_PATH[locale];
const product = PRODUCTS.find((one) => one.slug === HOME_PRODUCT)!;
const trail: [string, string][] = [[product.name, ""], [t.short, path]];
const ink = inkOf(product);
const only = tally(t);
const tint = "bg-[color-mix(in_srgb,var(--accent)_10%,transparent)]";
const [featured, ...others] = compared.rivals;
const priced = (own?: string) => (own ? href(locale, own) : undefined);
---

<Layout
  title={t.title}
  description={t.meta}
  locale={locale}
  paths={COMPARE_PATH}
  schema={[
    crumbs(locale, trail),
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      url: canonical(locale, path),
      name: t.title,
      description: t.meta,
      about: { "@id": appId(product.slug) },
      mentions: others.map((one) => ({ "@type": "SoftwareApplication", name: one.name, url: one.url })),
    },
    ...(t.faq
      ? [
          {
            "@context": "https://schema.org",
            "@type": "FAQPage",
            mainEntity: t.faq.items.map((one) => ({ "@type": "Question", name: one.q, acceptedAnswer: { "@type": "Answer", text: one.a } })),
          },
        ]
      : []),
  ]}
>
  <section class="shell pt-10 sm:pt-14" style={`--accent: ${product.accent}`}>
    <Crumbs locale={locale} trail={trail} />
    <header class="mt-10 max-w-3xl">
      <p class="eyebrow">{t.short}</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-[-0.03em] sm:text-5xl">{t.heading}</h1>
      <p class="mt-5 text-lg text-body">{t.lede}</p>
      <p class="mt-6 inline-flex items-center gap-2 rounded-full border border-line px-4 py-1.5 font-display text-base font-semibold text-fg" style="border-color: color-mix(in srgb, var(--accent) 45%, transparent)">
        <Icon name="star" class="h-4 w-4" />
        {only}
      </p>
      <p class="mt-4 text-sm text-muted">{t.checked}</p>
    </header>

    <div class="mt-10 hidden overflow-hidden rounded-3xl border border-line bg-surface xl:block">
      <table class="w-full table-fixed border-collapse text-left text-sm">
        <caption class="sr-only">{t.heading}</caption>
        <colgroup>
          <col class="w-[11rem]" />
          <col class="w-[12rem]" />
          {others.map(() => <col />)}
        </colgroup>
        <thead>
          <tr class="border-b border-line">
            <td class="p-4"></td>
            {
              compared.rivals.map((one, at) => (
                <th scope="col" class:list={["p-4 font-display text-base font-semibold text-fg", { [tint]: at === 0 }]}>
                  <a class="hover:underline" href={one.url} rel="noopener">{one.name}</a>
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            t.rows.map((row) => (
              <tr class="border-b border-line last:border-0">
                <th scope="row" class="p-4 align-top font-medium text-fg">{row.label}</th>
                {row.cells.map((cell, at) => (
                  <td class:list={["break-words p-4 align-top", { [tint]: at === 0 }]}>
                    <Verdict cell={cell} label={t.marks[cell.mark]} ink={at === 0 ? ink : undefined} to={at === 0 ? priced(row.own) : undefined} />
                    {cell.note && <span class="mt-1 block text-[13px] leading-snug text-muted">{cell.note}</span>}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:hidden">
      {
        t.rows.map(({ label, cells: [mine, ...theirs], own }) => (
          <li class="card p-5">
            <h2 class="font-display text-lg font-semibold leading-snug text-fg">{label}</h2>
            <div class:list={["mt-3 rounded-2xl p-3", tint]}>
              <span class="flex items-center justify-between gap-3">
                <span class="font-display text-sm font-semibold text-fg">{featured.name}</span>
                <Verdict cell={mine} label={t.marks[mine.mark]} ink={ink} to={priced(own)} />
              </span>
              {mine.note && <span class="mt-1 block text-[13px] leading-snug text-body">{mine.note}</span>}
            </div>
            <dl class="mt-3 divide-y divide-line text-sm">
              {theirs.map((cell, at) => (
                <div class="flex items-start gap-3 py-2">
                  <dt class="w-28 shrink-0 text-fg">{others[at].name}</dt>
                  <dd class="min-w-0">
                    <Verdict cell={cell} label={t.marks[cell.mark]} />
                    {cell.note && <span class="block text-[13px] leading-snug text-muted">{cell.note}</span>}
                  </dd>
                </div>
              ))}
            </dl>
          </li>
        ))
      }
    </ul>
  </section>

  {
    t.agent && (
      <section class="shell mt-20" style={`--accent: ${product.accent}`}>
        <h2 class="section-title">{t.agent.title}</h2>
        <div class="mt-4 max-w-3xl space-y-4 text-lg text-body">
          {t.agent.body.map((one) => <p>{one}</p>)}
        </div>
        <a class="mt-6 inline-flex items-center gap-1.5 font-medium text-fg hover:underline" href={t.agent.link.url}>
          {t.agent.link.label}
          <Icon name="arrow" class="h-4 w-4" />
        </a>
      </section>
    )
  }

  {
    t.faq && (
      <section class="shell mt-20">
        <h2 class="section-title">{t.faq.title}</h2>
        <dl class="mt-8 grid gap-4 md:grid-cols-2">
          {t.faq.items.map((one) => (
            <div class="card p-6">
              <dt class="font-display text-lg font-semibold text-fg">{one.q}</dt>
              <dd class="mt-2 text-body">{one.a}</dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  <section class="shell mt-20">
    <h2 class="section-title">{t.stronger.title}</h2>
    <p class="mt-3 text-muted">{t.stronger.lede}</p>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        t.stronger.items.map(([name, text]) => (
          <li class="card p-6">
            <h3 class="font-display text-lg font-semibold text-fg">{name}</h3>
            <p class="mt-2 text-body">{text}</p>
          </li>
        ))
      }
    </ul>
    <a class="btn-primary mt-10" href={`${href(locale)}#download`}>
      <Icon name="download" class="h-4 w-4" />
      {t.back}
    </a>
  </section>

  <section class="shell mt-20">
    <h2 class="eyebrow">{t.sources}</h2>
    <div class="mt-4 grid gap-6 text-sm sm:grid-cols-2 lg:grid-cols-3">
      {
        compared.sources.map(([name, urls]) => (
          <div>
            <h3 class="font-medium text-fg">{name}</h3>
            <ul class="mt-2 space-y-1">
              {urls.map((url) => (
                <li class="break-all">
                  <a class="text-muted underline decoration-muted underline-offset-4 hover:text-fg" href={url} rel="noopener">
                    {url.replace(/^https:\/\/(www\.)?/, "")}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</Layout>
