---
import Icon from "./Icon.astro";
import type { Doc } from "../content/docs";

interface Props {
  current: string;
  overview: { label: string; href: string; on: boolean };
  sections: [string, Doc[]][];
  linkOf: (one: Doc) => string;
  language?: { eyebrow: string; label: string; href: string };
  source?: { label: string; href: string };
}

const { current, overview, sections, linkOf, language, source } = Astro.props;
const item = (on: boolean) =>
  `block rounded-lg px-3 py-1.5 ${on ? "bg-fg/[0.06] font-medium text-fg" : "text-body hover:text-fg"}`;
---

<a href={overview.href} class={item(overview.on)} aria-current={overview.on ? "page" : undefined}>
  {overview.label}
</a>
{
  sections.map(([section, list]) => (
    <div class="mt-5">
      <p class="eyebrow px-3 text-[11px]">{section}</p>
      <ul class="mt-2 space-y-0.5">
        {list.map((one) => (
          <li>
            <a href={linkOf(one)} class={item(one.id === current)} aria-current={one.id === current ? "page" : undefined}>
              {one.data.title}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))
}
{
  language && (
    <div class="mt-5">
      <p class="eyebrow px-3 text-[11px]">{language.eyebrow}</p>
      <a href={language.href} class={`${item(false)} mt-2 flex items-center gap-2`}>
        {language.label}
        <Icon name="arrow" class="h-3.5 w-3.5 -rotate-45 text-muted" />
      </a>
    </div>
  )
}
{
  source && (
    <a href={source.href} rel="noopener" class="mt-5 block border-t border-line px-3 pt-4 text-sm text-muted hover:text-fg">
      {source.label}
    </a>
  )
}
