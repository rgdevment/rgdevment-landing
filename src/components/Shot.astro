---
import { createHash } from "node:crypto";
import { readFileSync } from "node:fs";
import { type Product, shotSrc } from "../content/products";
import type { Locale } from "../site";

interface Props {
  product: Product;
  locale: Locale;
  eager?: boolean;
  sizes?: string;
  class?: string;
}

const { product, locale, eager = false, sizes = "(min-width: 1088px) 1000px, calc(100vw - 3.5rem)", class: klass = "" } = Astro.props;
const shot = product.shot!;
const src = shotSrc(product, locale)!;
const webp = src.replace(/\.png$/, "");
// The screen keeps its name when an app ships a new one, so the address carries what it holds and a browser may keep it for a year.
const version = createHash("sha256").update(readFileSync(`./public${src}`)).digest("hex").slice(0, 10);
const at = (path: string) => `${path}?v=${version}`;
---

<picture>
  <source srcset={`${at(`${webp}-720.webp`)} 720w, ${at(`${webp}-1280.webp`)} 1280w, ${at(`${webp}.webp`)} ${shot.width}w`} sizes={sizes} type="image/webp" />
  <img
    src={at(src)}
    width={shot.width}
    height={shot.height}
    alt={locale === "es" ? shot.es : shot.en}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : undefined}
    decoding="async"
    class={klass}
  />
</picture>
