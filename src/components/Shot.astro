---
import { type Product, shotSrc } from "../content/products";
import type { Locale } from "../site";
import { versioned } from "../versioned";

interface Props {
  product: Product;
  locale: Locale;
  eager?: boolean;
  sizes?: string;
  class?: string;
}

const { product, locale, eager = false, sizes = "(min-width: 1088px) 1000px, calc(100vw - 3.5rem)", class: klass = "" } = Astro.props;
const shot = product.shot!;
const src = shotSrc(product, locale)!;
const webp = src.replace(/\.png$/, "");
---

<picture>
  <source srcset={`${versioned(`${webp}-720.webp`)} 720w, ${versioned(`${webp}-1280.webp`)} 1280w, ${versioned(`${webp}.webp`)} ${shot.width}w`} sizes={sizes} type="image/webp" />
  <img
    src={versioned(src)}
    width={shot.width}
    height={shot.height}
    alt={locale === "es" ? shot.es : shot.en}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : undefined}
    decoding="async"
    class={klass}
  />
</picture>
